    (cl-letf* ((schedule (symbol-function 'run-at-time))
               ((symbol-function 'run-at-time)
                (lambda (&rest arguments)
                  (let ((timer (apply schedule arguments)))
                    (push timer timers) timer))))
      (unwind-protect
          (progn
            ;; Use complete Markdown blocks, as received from a streamed reply.
            ;; Their parsed bodies include the line break before the delimiter.
            (cl-letf (((symbol-function 'agent-chat--math-render)
                       (lambda (source body block)
                         (should block)
                         (should (string-suffix-p "\n" body))
                         (push (agent-chat--math-request body block) entries)
                         source)))
              (dolist (body '("F_Q:G_1\\to G_T,\\qquad X\\mapsto e(X,Q)."
                              "Y\\longmapsto F_Q^{-1}(e(P,Y))"
                              "\\sigma=[x]H(m)."
                              "e(\\sigma,Q)=e(H(m),V)."
                              "[x]^B=(x_j^B)_j,\\qquad x=\\bigoplus_j x_j^B,"
                              "\\boxed{C_t=C_0\\oplus D_t,\\qquad T_t=T_0\\oplus E_t.}"
                              "\\boxed{\nD_1H^3+(D_1+D_2)H^2\n=E^{(1)}+E^{(2)}.\n}"
                              "x+y. % trailing comment"
                              "\n z_1+z_2.\n"))
                (dolist (delimiters '(("\\[" . "\\]") ("$$" . "$$")))
                  (agent-chat--markdown
                   (concat (car delimiters) "\n" body "\n" (cdr delimiters))))))
            (agent-chat--math-next)
            (let ((deadline (+ (float-time) 20)))
              (while (and (< (float-time) deadline)
                          (cl-some (lambda (entry)
                                     (memq (plist-get entry :status) '(queued running))) entries))
                (accept-process-output nil 0.05)))
            (should (= (length entries) 18))
            (dolist (entry entries)
              (ert-info ((format "Formula %S: %S"
                                 (plist-get entry :body) (plist-get entry :error)))
                (should (eq (plist-get entry :status) 'ready))
                (should (file-exists-p (image-property (plist-get entry :image) :file))))))
        (dolist (entry entries) (agent-chat--math-finish entry nil))
        (mapc #'cancel-timer timers)))))

(ert-deftest agent-chat-math-gui-preserves-org-image-in-history ()
  (skip-unless (and (display-graphic-p) (image-type-available-p 'svg)))
  (agent-chat--with-test-composer
   (let ((source "\\[\nD[i]=v,\n\\]")
         (body "\nD[i]=v,\n")
         (svg "<svg xmlns='http://www.w3.org/2000/svg' width='80' height='80'><path d='M0 0h80v80H0Z'/></svg>")
         (agent-chat--math-cache (make-hash-table :test #'equal))
         (line-spacing nil))
     (dolist (scale '(0 4))
       (text-scale-set scale)
       (dolist (ascent '(50 98 100))
         (dolist (factor '(1.2 3.4))
           (let* ((height (floor (* factor (window-font-height))))
                  (image (create-image svg 'svg t :width 80 :height height
                                       :scale 1 :ascent ascent))
                  (images 0))
             (puthash (agent-chat--math-key body t)
                      (list :status 'ready :image image :buffers nil)
                      agent-chat--math-cache)
             (setf (agent-chat--state-history agent-chat--state)
                   (list (list :role 'assistant
                               :text (concat "Before.\n\n" source "\n\nAfter."))))
             (setq agent-chat--render-cache nil agent-chat--render-block-cache nil)
             (let ((text (agent-chat--reading-text
                          (agent-chat--history-lines (selected-window)))))
               (erase-buffer)
               (insert text)
               (should (string-match-p (regexp-quote source)
                                       (agent-chat--math-copy-source text))))
             (goto-char (point-min))
             (redisplay t)
             (while (< (point) (point-max))
               (let ((display (get-text-property (point) 'display)))
                 (when (get-text-property (point) 'agent-chat-math-source)
                   ;; Ebox must retain Org's whole image and baseline even for
                   ;; formulas taller than a text line, without synthetic rows.
                   (should (eq (car display) 'image))
                   (should (= (image-property display :ascent) ascent))
                   (should (= (image-property display :height) height))
                   (should-not (get-text-property (line-end-position) 'line-height))
                   (cl-incf images)))
               (goto-char (next-single-property-change
                           (point) 'display nil (point-max))))
             (ert-info ((format "Scale %s, ascent %s, height %s" scale ascent height))
               (should (= images 1)))
             (should (= (image-property image :ascent) ascent)))))))))

