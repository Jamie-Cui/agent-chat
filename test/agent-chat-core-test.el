(ert-deftest agent-chat-permission-bypass-keeps-unoffered-options-and-session-isolation ()
  (agent-chat--with-test-session
   (setf (agent-chat--session-busy session) t)
   (let (responses)
     (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
               ((symbol-function 'acp-send-response)
                (lambda (&rest args) (push (plist-get args :response) responses))))
       (agent-chat-toggle-permission-bypass)
       (let ((request (agent-chat--test-permission 7)))
         (setf (alist-get 'options (alist-get 'params request))
               [((optionId . "always") (kind . "allow_always") (name . "Always allow"))])
         (agent-chat--incoming-request session request)
         (should (agent-chat--permission-pending-p session request)))
       (should-not responses)
       ;; A separate conversation and a replacement in this buffer start off.
       (agent-chat--with-test-session
        (should-not (agent-chat--permission-bypass-p session)))
       (let* ((replacement (copy-agent-chat--session session))
              (agent-chat--session replacement))
         (should-not (agent-chat--permission-bypass-p replacement))
         (should-not (agent-chat--permission-bypass-p session)))
       ;; Reentrant request delivery uses its own exact advertised option.
       (cl-letf (((symbol-function 'acp-send-response)
                  (lambda (&rest args)
                    (let ((response (plist-get args :response)))
                      (push response responses)
                      (when (= 8 (map-elt response :request-id))
                        (agent-chat--incoming-request session (agent-chat--test-permission 9)))))))
         (agent-chat--incoming-request session (agent-chat--test-permission 8)))
       (should (equal '(9 8) (mapcar (lambda (r) (map-elt r :request-id)) responses)))
       (cl-letf (((symbol-function 'acp-shutdown) #'ignore)
                 ((symbol-function 'acp-send-notification) #'ignore))
         (agent-chat--disconnect session))
       (should-not agent-chat--permission-bypass-session)))))

