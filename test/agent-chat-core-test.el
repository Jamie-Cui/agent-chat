(defmacro agent-chat--with-test-session (&rest body)
  `(agent-chat--with-test-composer
     (let ((session (agent-chat--session-create
                     :buffer (current-buffer) :agent 'test :cwd default-directory
                     :client (acp-make-client :command "cat") :id "test" :phase 'ready)))
       (setq agent-chat--session session
             agent-chat--adapter
             (lambda (request emit) (agent-chat--send session request emit)))
       ,@body)))

(defun agent-chat--test-update (session kind &rest fields)
  (agent-chat--notification
   session `((method . "session/update")
             (params (sessionId . "test") (update (sessionUpdate . ,kind) ,@fields)))))

(defmacro agent-chat--with-test-queue (&rest body)
  `(agent-chat--with-test-session
    (let (sent finish fail)
      (cl-letf (((symbol-function 'acp-send-request)
                 (lambda (&rest args)
                   (push (map-elt (seq-elt (map-nested-elt (plist-get args :request)
                                                          '(:params prompt)) 0) 'text) sent)
                   (setq finish (plist-get args :on-success)
                         fail (plist-get args :on-failure))))
                ((symbol-function 'acp-send-notification) #'ignore)
                ((symbol-function 'acp-send-response) #'ignore))
        ,@body))))

(ert-deftest agent-chat-queue-fifo-preserves-draft-and-history ()
