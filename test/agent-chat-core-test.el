(ert-deftest agent-chat-process-groups-absorb-granted-approvals-without-hiding-failures ()
  (agent-chat--with-test-composer
   (setq-local agent-chat-process-groups-expand-by-default nil)
   (insert "Keep draft") (goto-char 4)
   (let* ((allowed '(((optionId . "allow") (name . "Allow once") (kind . "allow_once"))))
          (history
           `((:role user :text "Run checks")
             (:role tool :text "First command" :detail "First output" :tool-status "completed")
             (:role permission :text "First command" :request-id 7 :resolved "allow" :options ,allowed)
             (:role reasoning :text "Inspect results")
             (:role tool :text "Second command" :detail "Failure details" :tool-status "failed")
             (:role permission :text "Second command" :request-id 8 :resolved "allow" :options ,allowed)
             (:role assistant :text "Report")))
          (original (copy-tree history))
          (draft (buffer-string)) (cursor (point)) (undo buffer-undo-list))
     (setf (agent-chat--state-history agent-chat--state) history)
     ;; A pending row stays visible; resolving it merges previously cached blocks.
     (setf (plist-get (nth 5 history) :resolved) nil)
     (agent-chat--publish)
     (should (string-match-p "Permission pending"
                             (agent-chat--test-history-string)))
     (setf (plist-get (nth 5 history) :resolved) "allow")
     (agent-chat--publish)
     (let* ((display (agent-chat--test-history-string))
            (summary "Activity · 2 tools · 1 thought · 2 approved · 1 failed"))
       (should (string-match-p summary display))
       (should (= 2 (length (split-string display "Activity ·"))))
       (should-not (string-match-p "First command\\|Second command\\| · allow" display))
       (should (memq 'agent-chat-error
                     (ensure-list (get-text-property (string-match summary display) 'face display))))
       (should (= 1 (agent-chat--process-group-start 4)))
       (agent-chat--toggle-process-group 1)
       (should (string-match-p "First command · allow" (agent-chat--test-history-string)))
       (agent-chat-toggle-details 4)
       (should (string-match-p "Failure details" (agent-chat--test-history-string)))
       (agent-chat--toggle-process-group 1)
       (should-not (string-match-p "Failure details\\| · allow" (agent-chat--test-history-string))))
     (let ((full (agent-chat--transcript agent-chat--state t)))
       (should (string-match-p "First output" full))
       (should (string-match-p "Failure details" full))
       (should (string-match-p "First command · allow" full)))
     (should (equal original (agent-chat--state-history agent-chat--state)))
     (should (equal draft (buffer-string)))
     (should (= cursor (point)))
     (should (eq undo buffer-undo-list)))))

