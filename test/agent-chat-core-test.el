(ert-deftest agent-chat-table-gui-math-wraps-as-images-and-copies-source ()
  (skip-unless (and (display-graphic-p) (image-type-available-p 'svg)))
  (agent-chat--with-test-composer
   (let* ((agent-chat--math-cache (make-hash-table :test #'equal))
          (agent-chat--math-window (selected-window))
          (ebox--measure-buffer (current-buffer))
          (body "L_j=\\operatorname{Com}(\\ell_j;r_j)")
          (formula (concat "\\(" body "\\)"))
          (source (concat "| Randomness | Where used | Purpose |\n|:---|:---:|---:|\n"
                          "| \\(r_j\\) | " formula " | Hide \\(\\ell_j\\) |\n"
                          "| `\\(literal\\)` | x<br>y | [Doc](guide.org) |"))
          (spec (create-image "<svg xmlns='http://www.w3.org/2000/svg' width='240' height='24'><rect width='240' height='24'/></svg>"
                              'svg t :height '(0.8 . em))))
     (dolist (text (list "r_j" body "\\ell_j"))
       (puthash (agent-chat--math-key text nil)
                (list :status 'ready :image spec :buffers nil) agent-chat--math-cache))
     (dolist (scale '(0 3))
       (text-scale-set scale)
       (ebox-clear-cache)
       (dolist (width '(18 40 100))
         (let* ((rendered (agent-chat--markdown source width))
                (lines (split-string rendered "\n"))
                (pixels (mapcar #'ebox-string-pixel-width lines))
                (copied (agent-chat--math-copy-source rendered))
                (pos 0) (images 0))
           (unless (<= (apply #'max pixels) (* width (window-font-width)))
             (ert-fail (list :scale scale :width width :font-width (window-font-width)
                             :lines (cl-mapcar (lambda (line pixels) (list line pixels)) lines pixels))))
           (when (string-prefix-p "┌" rendered)
             (unless (cl-every (lambda (n) (<= (abs (- n (car pixels))) 1)) pixels)
               (ert-fail (list :scale scale :width width :lines
                               (cl-mapcar (lambda (line pixels) (list line pixels)) lines pixels)))))
           (while (< pos (length rendered))
             (when (get-text-property pos 'agent-chat-math-source rendered)
               (should (eq (car-safe (get-text-property pos 'display rendered)) 'image))
               (cl-incf images))
             (setq pos (next-single-property-change pos 'agent-chat-math-source rendered (length rendered))))
           (should (= images 3))
           (should (string-search formula copied))
           (should (string-search "\\(r_j\\)" copied))
           (should (string-search "\\(\\ell_j\\)" copied))
           (should-not (gethash (agent-chat--math-key "literal" nil) agent-chat--math-cache))
           (should (equal (get-text-property (string-match "Doc" rendered) 'agent-chat-link rendered)
                          "guide.org")))))
     (should (equal (image-property spec :height) '(0.8 . em))))))

