                 ((symbol-function 'input-pending-p) (lambda () input))
                 ((symbol-function 'transient-setup)
                  (lambda (_prefix _layout _edit &rest args)
                    (push (plist-get args :scope) popups)
                    (setq overriding-terminal-local-map (make-sparse-keymap))))
                 ((symbol-function 'acp-send-response)
