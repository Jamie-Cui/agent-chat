(ert-deftest agent-chat-revert-retries-failures-without-restarting-session ()
  (agent-chat--with-test-composer
   (insert "unsent draft") (goto-char 4) (set-mark 2) (setq mark-active t)
   (let* ((agent-chat--math-cache (make-hash-table :test #'equal))
          (agent-chat--math-queue nil)
          (body "s_t=(cid,t,C_t,\\mathsf{policy})")
          (failed (list :status 'failed :attempt 2 :buffers (list (current-buffer))))
          (other (list :status 'failed :attempt 2 :buffers nil))
          (ready (list :status 'ready :image '(image :type svg) :buffers (list (current-buffer))))
          (running (list :status 'running :attempt 1 :buffers (list (current-buffer))))
          (session (agent-chat--session-create :buffer (current-buffer) :phase 'ready))
          (state agent-chat--state)
          (undo buffer-undo-list) (draft (buffer-string))
          (cursor (point)) (selection (mark)) (modified (buffer-modified-p))
          (timer (run-at-time 60 nil #'ignore)))
     (setq agent-chat--session session agent-chat--render-timer timer
           agent-chat--code-cache '(stale))
     (setf (agent-chat--state-status state) 'running
           (agent-chat--state-cancel state) (lambda () (ert-fail "Refresh cancelled the turn")))
     (agent-chat--append state 'assistant (concat "Formula\n\\[\n" body "\n\\]"))
     (puthash (agent-chat--math-key (concat "\n" body "\n") t) failed agent-chat--math-cache)
