(ert-deftest agent-chat-permission-popup-selects-request-and-exact-decision ()
  (agent-chat--with-test-session
   (setf (agent-chat--session-busy session) t)
   (insert "unfinished draft") (goto-char 4)
   (let ((text (buffer-string)) (point (point)) (undo buffer-undo-list) popup responses action)
     (cl-letf (((symbol-function 'transient-setup)
                (lambda (_prefix _layout _edit &rest args) (setq popup (plist-get args :scope))))
               ((symbol-function 'completing-read)
                (lambda (&rest _) (ert-fail "Permissions must use a popup")))
               ((symbol-function 'acp-send-response)
                (lambda (&rest args) (push (plist-get args :response) responses))))
       (agent-chat--incoming-request session (agent-chat--test-permission 7))
       (agent-chat--append agent-chat--state 'assistant "Progress")
       (agent-chat--incoming-request session (agent-chat--test-permission 8))
       (dolist (display (list (agent-chat--test-history-string)
                             (agent-chat--transcript agent-chat--state)))
         (should (string-suffix-p
                  "2 permissions pending — press C-c C-p to reopen the permission menu"
                  (string-clean-whitespace display)))
         (should (= 2 (length (split-string display "permissions pending"))))
         (should-not (string-match-p "Read example\\|example.txt\\|\\[Allow\\|\\[Reject\\|\\[Cancel" display)))
       (should (string-match-p "example.txt" (agent-chat--transcript agent-chat--state t)))
       ;; The reminder is informational; RET cannot answer a pending request.
       (with-current-buffer agent-chat--history-buffer
         (goto-char (point-min))
         (search-forward "permissions pending")
         (agent-chat--history-activate))
       (should-not responses)
       (agent-chat-permissions)
       (should (string-prefix-p "Permission 1/2" (plist-get popup :heading)))
       (should-not responses)
       (call-interactively (nth 2 (assoc "N" (plist-get popup :queue))))
       (should (string-prefix-p "Permission 2/2" (plist-get popup :heading)))
       (should-not responses)
       (setq action (nth 2 (assoc "d" (plist-get popup :respond))))
       (call-interactively action)
       (should (= (length responses) 1))
       (should (equal (map-elt (car responses) :request-id) 8))
       (should (equal (map-nested-elt (car responses) '(:result outcome optionId)) "reject_once"))
       (should-error (call-interactively action) :type 'user-error)
       (should (= (length responses) 1))
       (should (string-match-p "Permission pending" (agent-chat--test-history-string)))
       (should-not (string-match-p "2 permissions pending" (agent-chat--test-history-string)))
       (agent-chat-permissions)
       (should (string-prefix-p "Permission 1/1" (plist-get popup :heading)))
       (call-interactively (nth 2 (assoc "x" (plist-get popup :respond))))
       (should (equal (map-nested-elt (car responses) '(:result outcome outcome)) "cancelled"))
       (should-not (agent-chat--session-permissions session))
       (should-not (string-match-p "to reopen the permission menu"
                                   (string-clean-whitespace (agent-chat--test-history-string))))
       (should (equal (buffer-string) text))
       (should (= (point) point))
       (should (eq buffer-undo-list undo))))))

