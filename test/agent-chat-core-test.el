(ert-deftest agent-chat-native-editing-matches-ordinary-buffer ()
  (skip-unless (bound-and-true-p evil-mode))
  (save-window-excursion
    (let (results)
      (dolist (mode '(text-mode agent-chat-mode))
        (let ((buffer (generate-new-buffer " *agent-chat-equivalence*")))
          (unwind-protect
              (progn
                (switch-to-buffer buffer)
                (funcall mode)
                (buffer-enable-undo)
                (evil-local-mode 1) (evil-normal-state)
                (when (eq mode 'agent-chat-mode)
                  (agent-chat--attach (agent-chat--state-create) nil "Test")
                  (agent-chat--redraw))
                (execute-kbd-macro
                 (kbd "i o n e SPC t w o SPC t h r e e SPC f o u r <escape> 0 2 d w"))
                (execute-kbd-macro (kbd "u"))
                (execute-kbd-macro (kbd "C-r"))
                (execute-kbd-macro (kbd "0 v 2 l y A ! <escape> p"))
                (execute-kbd-macro (kbd "0 \" a y w $ \" a p"))
                (push (list (buffer-string) (point) evil-state) results))
            (kill-buffer buffer))))
      (should (equal (car results) (cadr results))))))

(ert-deftest agent-chat-native-closing-cancels-once ()
