(ert-deftest agent-chat-history-startup-lists-all-pages-with-new-session ()
  (dolist (selection '(("New session" . :new) ("First · one" . "one")
                       ("Second · two" . "two")))
    (agent-chat--with-test-composer
     (let ((session (agent-chat--session-create
                     :buffer (current-buffer) :cwd default-directory
                     :capabilities '((sessionCapabilities . ((list . nil))))))
           cursors callback selected (prompts 0))
       (setq agent-chat--session session)
       (cl-letf (((symbol-function 'agent-chat--request)
                  (lambda (_session request success &rest _)
                    (should (equal (map-elt request :method) "session/list"))
                    (let ((cursor (map-nested-elt request '(:params cursor))))
                      (push cursor cursors)
                      (funcall success
                               (pcase cursor
                                 ('nil '((sessions . [((sessionId . "one") (title . "First"))])
                                         (nextCursor . "page-2")))
                                 ("page-2" '((sessions . []) (nextCursor . "page-3")))
                                 ("page-3" '((sessions . [((sessionId . "two") (title . "Second"))]))))))))
                 ((symbol-function 'run-at-time)
                  (lambda (_time _repeat function &rest _) (setq callback function)))
                 ((symbol-function 'completing-read)
                  (lambda (_prompt table &rest _)
                    (cl-incf prompts)
                    (should (equal (all-completions "" table)
                                   '("New session" "First · one" "Second · two")))
                    (should (eq (completion-metadata-get
                                 (completion-metadata "" table nil) 'display-sort-function)
                                #'identity))
                    (car selection)))
                 ((symbol-function 'agent-chat--new-session)
                  (lambda (_) (setq selected :new)))
                 ((symbol-function 'agent-chat--load-session)
                  (lambda (_ id) (setq selected id))))
         (agent-chat--list-history session nil t)
         (should (equal (nreverse cursors) '(nil "page-2" "page-3")))
         (should (zerop prompts))
         (funcall callback)
         (should (= prompts 1))
         (should (equal selected (cdr selection))))))))

(ert-deftest agent-chat-history-startup-bounds-labels-and-preserves-identity ()
  (let* ((long (concat "\n " (make-string 100 ?\u3042) "\n/path/to/context\tquestion"))
         (one `((sessionId . "one") (title . ,long)))
         (two `((sessionId . "two") (title . ,long)))
         (label (agent-chat--session-label one)))
    (should-not (string-match-p "[\n\r\t]" label))
    (should (<= (string-width (car (split-string label " · "))) 60))
    (should (string-suffix-p "… · one" label))
    (should (equal (agent-chat--session-label '((sessionId . "empty") (title . " \n\t")))
                   "Untitled · empty"))
    (agent-chat--with-test-composer
     (let ((session (agent-chat--session-create :buffer (current-buffer) :cwd default-directory))
           callback selected)
       (setq agent-chat--session session)
       (cl-letf (((symbol-function 'run-at-time)
                  (lambda (_time _repeat function &rest _) (setq callback function)))
                 ((symbol-function 'completing-read)
                  (lambda (_prompt table &rest _)
                    (should (equal (all-completions "" table)
                                   (list label (agent-chat--session-label two))))
                    (agent-chat--session-label two)))
                 ((symbol-function 'agent-chat--load-session)
                  (lambda (_ id) (setq selected id))))
         (agent-chat--select-session session (list one two))
         (funcall callback)
         (should (equal selected "two")))))))

