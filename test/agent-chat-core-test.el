       (should-not agent-chat--render-timer)
       (should-not (memq timer timer-list))
       (should (eq state agent-chat--state))
       (should (eq session agent-chat--session))
       (should (eq (agent-chat--session-phase session) 'ready))
       (should (eq (agent-chat--state-status state) 'running))
       (should (equal draft (buffer-string)))
       (should (eq undo buffer-undo-list))
       (should (= cursor (point))) (should (= selection (mark)))
       (should mark-active)
       (should (eq modified (buffer-modified-p)))))))

