(ert-deftest agent-chat-math-real-cjk-aligned-compilation ()
  (skip-unless (and (executable-find "xelatex") (executable-find "dvisvgm")))
  (let ((agent-chat--math-cache (make-hash-table :test #'equal))
        (agent-chat--math-queue nil)
        (agent-chat--math-running nil)
        (org-latex-compiler "xelatex")
        (org-latex-preview-process-precompile nil)
        (org-latex-preview-process-default 'dvisvgm)
        (org-latex-packages-alist '(("" "xeCJK" t)))
        (body (concat "\\begin{aligned}\n"
                      "\\mathsf{Accept} \\iff{}&\n"
                      "\\mathsf{TLSNVerify}(\\sigma_U,\\text{\u3042\u3044})=1\\\\\n"
                      "&\\land \\mathsf{ServerName}=S\\\\\n"
                      "&\\land D_{\\to}=[0,|T_{\\to}|)\\setminus H\\\\\n"
                      "&\\land D_{\\leftarrow}=[0,|T_{\\leftarrow}|)\\\\\n"
                      "&\\land \\mathsf{Mask}_H(T_{\\to})\n"
                      "=\\mathsf{Mask}_H(\\mathsf{EncodeRequest}(q))\\\\\n"
                      "&\\land \\mathsf{ProfileValid}(T_{\\leftarrow})\\\\\n"
                      "&\\land \\mathsf{StatusBody}(T_{\\leftarrow})=b.\n"
                      "\\end{aligned}"))
        entries timers)
    (cl-letf* ((schedule (symbol-function 'run-at-time))
               ((symbol-function 'run-at-time)
                (lambda (&rest arguments)
                  (let ((timer (apply schedule arguments)))
                    (push timer timers) timer))))
      (unwind-protect
          (progn
            (setq entries (list (agent-chat--math-request body t)
                                (agent-chat--math-request "\\text{\u3042\u3044}" nil)
                                ;; Unassigned Unicode must fall back, not disappear.
                                (agent-chat--math-request
                                 (concat "\\text{" (string #x0378) "}") nil)))
            (agent-chat--math-next)
            (let ((deadline (+ (float-time) 30)))
              (while (and (< (float-time) deadline)
                          (cl-some (lambda (entry)
                                     (memq (plist-get entry :status) '(queued running))) entries))
                (accept-process-output nil 0.05)))
            (dolist (entry (butlast entries))
              (should (eq 'ready (plist-get entry :status)))
              (should (file-exists-p (image-property (plist-get entry :image) :file))))
            (should (eq 'failed (plist-get (car (last entries)) :status))))
        (dolist (entry entries) (agent-chat--math-finish entry nil))
        (mapc #'cancel-timer timers)))))

(ert-deftest agent-chat-math-org-renders-newline-delimited-display-formulas ()
  (skip-unless (and (executable-find "latex") (executable-find "dvisvgm")))
