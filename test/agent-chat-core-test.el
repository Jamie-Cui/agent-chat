       (insert "/permissions")
       (should-error (agent-chat-submit) :type 'user-error)
       (should (equal (buffer-string) "/permissions"))))))

;; A real local stdio peer exercises acp.el framing, ordering and callbacks.
;; This fixture never reads files, executes tools, or makes network requests.
(defconst agent-chat--test-peer
  "import json, sys
pending = None
cancel_id = None
def send(obj):
    print(json.dumps(dict(jsonrpc='2.0', **obj)), flush=True)
def reply(id, result):
    send(dict(id=id, result=result))
def update(kind, **fields):
    send(dict(method='session/update', params=dict(sessionId='test', update=dict(sessionUpdate=kind, **fields))))
for line in sys.stdin:
    req = json.loads(line)
    method, id = req.get('method'), req.get('id')
    if method == 'initialize':
        reply(id, dict(protocolVersion=1, agentCapabilities={}))
    elif method == 'session/new':
        reply(id, dict(sessionId='test'))
    elif method == 'session/prompt':
        prompt = req['params']['prompt'][0]['text']
        if prompt == 'exit-now':
            sys.exit(3)
        if prompt == 'cancel-me':
            cancel_id = id
            continue
        update('agent_thought_chunk', content=dict(type='text', text='Checking locally'))
        update('agent_message_chunk', messageId='a', content=dict(type='text', text='Hello '))
        update('agent_message_chunk', messageId='a', content=dict(type='text', text='world'))
        update('tool_call', toolCallId='read', title='Read example', status='in_progress')
        pending = id
        send(dict(id=700, method='session/request_permission', params=dict(sessionId='test', toolCall=dict(toolCallId='read', title='Read example'), options=[dict(optionId='allow_once', name='Allow once', kind='allow_once'), dict(optionId='reject_once', name='Reject', kind='reject_once')])))
    elif method == 'session/cancel':
        if cancel_id is not None:
            update('agent_message_chunk', content=dict(type='text', text='LATE CANCELLED CHUNK'))
            reply(cancel_id, dict(stopReason='cancelled'))
            cancel_id = None
    elif id == 700:
        update('tool_call_update', toolCallId='read', status='completed', content=[dict(type='content', content=dict(type='text', text='example output'))])
        outcome = req['result']['outcome']
        update('agent_message_chunk', messageId='b', content=dict(type='text', text=outcome.get('optionId', 'cancelled')))
        reply(pending, dict(stopReason='end_turn'))
")

(defun agent-chat--test-wait (predicate)
  (let ((deadline (+ (float-time) 4)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.01))
    (should (funcall predicate))))

(ert-deftest agent-chat-core-real-stdio-roundtrip ()
  (skip-unless (executable-find "python3"))
  (agent-chat--with-test-composer
   (let* ((before (buffer-list))
          (agent-chat-agents
           `((test :name "Test" :command (,(executable-find "python3") "-u" "-c"
                                          ,agent-chat--test-peer)))))
     (agent-chat--begin-connection 'test)
     (let ((session agent-chat--session))
       (agent-chat--test-wait (lambda () (eq (agent-chat--session-phase session) 'ready)))
       (insert "hello") (agent-chat-submit)
       (insert "draft during stream") (goto-char 6)
       (let ((point (point)) (undo buffer-undo-list))
         (agent-chat--test-wait (lambda () (agent-chat--session-permissions session)))
         (should (equal (buffer-string) "draft during stream"))
         (should (= point (point))) (should (eq undo buffer-undo-list)))
       (agent-chat--respond session 700 "allow_once")
       (agent-chat--test-wait (lambda () (not (agent-chat--session-busy session))))
       (let ((history (agent-chat--transcript agent-chat--state t)))
         (should (string-match-p "Hello world" history))
         (should (string-match-p "Checking locally" history))
         (should (string-match-p "example output" history))
         (should (string-match-p "allow_once" history)))
       (erase-buffer) (insert "cancel-me") (agent-chat-submit)
       (agent-chat-interrupt)
       (agent-chat--test-wait (lambda () (not (agent-chat--session-busy session))))
       (should-not (string-match-p "LATE CANCELLED CHUNK"
                                    (agent-chat--transcript agent-chat--state t)))
       (insert "exit-now") (agent-chat-submit)
       (agent-chat--test-wait
        (lambda () (eq (agent-chat--session-phase session) 'disconnected)))
       (should-not (agent-chat--session-busy session))
       (should (seq-every-p
                (lambda (buffer) (or (memq buffer before)
                                     (not (with-current-buffer buffer
                                            (derived-mode-p 'comint-mode))))) (buffer-list)))))))



(ert-deftest agent-chat-test-entry-preserves-registered-suites ()
  (let* ((name 'agent-chat-fixture-for-test-entry)
         (fixture (make-ert-test :name name :body (lambda () (should t)))))
    (unwind-protect
        (progn
          (ert-set-test name fixture)
          (let ((result (agent-chat-run-tests name)))
            (should (= 1 (plist-get result :passed)))
            (should (= 0 (plist-get result :failed))))
          (should (eq fixture (ert-get-test name))))
      (ert-delete-test name))))

