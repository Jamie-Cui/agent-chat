   (should (equal sent '("first")))
   (should (= 2 (length agent-chat--queue)))
   (should (= 1 (length (agent-chat--state-history agent-chat--state))))
   (insert "Unsent draft") (goto-char 3) (set-mark 6)
   (let ((undo buffer-undo-list) (old-finish finish))
     (funcall finish '((stopReason . "end_turn")))
     ;; Completing a turn does not recursively enter the next ACP request.
     (should (= 1 (length sent)))
     (agent-chat--test-wait (lambda () (= 2 (length sent))))
     (funcall old-finish '((stopReason . "end_turn")))
     (should (agent-chat--session-busy session))
     (should (= 1 (length agent-chat--queue)))
     (funcall finish '((stopReason . "end_turn")))
     (agent-chat--test-wait (lambda () (= 3 (length sent))))
     (should (equal (reverse sent) '("first" "second" "third")))
     (should (equal (buffer-string) "Unsent draft"))
     (should (= 3 (point))) (should (= 6 (mark)))
     (should (eq undo buffer-undo-list))
     (should-not agent-chat--queue))))

