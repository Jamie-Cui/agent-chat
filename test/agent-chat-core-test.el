(ert-deftest agent-chat-reading-faces-survive-font-lock ()
  (agent-chat--with-test-composer
   (insert "draft")
   (setf (agent-chat--state-history agent-chat--state)
         '((:role user :text "Question")
           (:role reasoning :text "Checking")
           (:role assistant :text "**Answer** and `inline`\n\n```python\n# comment\nprint(\"hello\")\n```\n\n| A | B |\n|---|---|\n| a | b |")))
   (agent-chat--publish)
   (agent-chat-browse-history)
   (let* ((positions (number-sequence (point-min) (1- (point-max))))
          (faces (mapcar (lambda (pos) (get-text-property pos 'face)) positions))
          (cursor (point)) (mark-position (mark t)))
     (should (memq 'agent-chat-user faces))
     (should (memq 'shadow faces))
     (should (seq-some (lambda (face) (and (listp face) (memq 'font-lock-string-face face))) faces))
     ;; Reading text already has renderer/native-code faces.  Redisplay's
     ;; JIT fontification and font-lock restarts must not erase those styles.
     (font-lock-fontify-region (point-min) (point-max))
     (font-lock-unfontify-region (point-min) (point-max))
     (should (equal faces (mapcar (lambda (pos) (get-text-property pos 'face)) positions)))
     (let ((noninteractive nil))
       (font-lock-mode 1)
       (font-lock-flush)
       (jit-lock-fontify-now (point-min) (point-max))
       (font-lock-mode -1)
       (font-lock-mode 1))
     (font-lock-ensure)
     (should (equal faces (mapcar (lambda (pos) (get-text-property pos 'face)) positions)))
     (should (= cursor (point)))
     (should (equal mark-position (mark t))))
   (agent-chat-focus-prompt)
   ;; The editable prompt must still use ordinary font-lock.
   (font-lock-add-keywords nil '(("draft" . font-lock-keyword-face)))
   (font-lock-fontify-region (point-min) (point-max))
