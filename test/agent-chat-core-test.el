                   (lambda (path &optional base)
                     (if (string-prefix-p home path)
                         (concat expanded-home (substring path (length home)))
                       (funcall expand-name path base))))
                  ((symbol-function 'project-current) (lambda (&rest _) project))
                  ((symbol-function 'project-root) (lambda (_) directory))
