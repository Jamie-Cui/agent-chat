     (puthash (agent-chat--math-key "ready" nil) ready agent-chat--math-cache)
     (puthash (agent-chat--math-key "running" nil) running agent-chat--math-cache)
     (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) nil))
