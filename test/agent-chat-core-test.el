(defun agent-chat--test-history-string ()
  (with-current-buffer agent-chat--history-buffer (buffer-string)))

(defmacro agent-chat--with-test-composer (&rest body)
  `(save-window-excursion
     (let ((buffer (generate-new-buffer " *agent-chat-test*"))
           (agent-chat-stream-refresh-interval 0))
       (unwind-protect
           (progn
             (switch-to-buffer buffer)
             (agent-chat-mode)
             (agent-chat--attach (agent-chat--state-create) nil "Test")
             (when (bound-and-true-p evil-local-mode) (evil-normal-state))
             (agent-chat--redraw)
             ,@body)
         (when (buffer-live-p buffer)
           (with-current-buffer buffer
             (let ((kill-buffer-query-functions nil)) (kill-buffer buffer))))))))

(ert-deftest agent-chat-mermaid-complete-fences-only ()
  (let (requests)
    (cl-letf (((symbol-function 'agent-chat--mermaid-render)
               (lambda (body) (push body requests) "diagram preview")))
      (should (string-match-p "A --> B" (agent-chat--markdown "```mermaid\nflowchart TD\nA --> B")))
      (should-not requests)
      (should (string-match-p "diagram preview"
                              (agent-chat--markdown "```mermaid\nflowchart TD\nA --> B\n```")))
      (should (equal requests '("flowchart TD\nA --> B")))
      (agent-chat--markdown "```text\nflowchart TD\nA --> B\n```")
      (should (= (length requests) 1)))))

(ert-deftest agent-chat-mermaid-cache-and-resource-guard ()
  (let ((agent-chat--mermaid-cache (make-hash-table :test #'equal))
        (agent-chat--mermaid-queue nil)
        (body "flowchart TD\nA[Start] --> B[Service]") scheduled)
    (cl-letf (((symbol-function 'executable-find) (lambda (_) "/local/mmdc"))
              ((symbol-function 'run-at-time) (lambda (&rest _) (push t scheduled))))
      (let ((entry (agent-chat--mermaid-request body)))
        (should (eq entry (agent-chat--mermaid-request body)))
        (should (= (length agent-chat--mermaid-queue) 1))
        (should (= (length scheduled) 1))
        (setf (plist-get entry :status) 'failed)
        (should (eq entry (agent-chat--mermaid-request body)))
        (should (= (length scheduled) 1)))
      (dolist (unsafe '("%%{init: {}}%%\nflowchart TD" "---\nconfig: {}\n---"
                        "flowchart TD\nA[<img src=x>]"
                        "flowchart TD\nA@{ img: 'https://example.invalid/x' }"))
        (should-not (agent-chat--mermaid-request unsafe))))))

(ert-deftest agent-chat-mermaid-local-render-and-copy ()
  (skip-unless (executable-find "mmdc"))
  (let ((agent-chat--mermaid-cache (make-hash-table :test #'equal))
        (agent-chat--mermaid-queue nil)
        (agent-chat--mermaid-running nil)
        (body "flowchart TD\nA[Start] --> B[Listener and service lifecycle]")
        entry)
    (unwind-protect
        (progn
          (setq entry (agent-chat--mermaid-request body))
          (agent-chat--mermaid-next)
          (let ((deadline (+ (float-time) 35)))
            (while (and (< (float-time) deadline)
                        (memq (plist-get entry :status) '(queued running)))
              (accept-process-output nil 0.05)))
          (should (eq (plist-get entry :status) 'ready))
          (should (string-prefix-p (unibyte-string 137 80 78 71) (plist-get entry :png)))
          (should-not (file-exists-p (plist-get entry :directory)))
          (when (and (display-graphic-p) (image-type-available-p 'png))
            (let* ((agent-chat--math-window (selected-window))
                   (rendered (agent-chat--mermaid-render body)))
              (should (get-text-property 0 'display rendered))
              (should (equal (string-trim-right (agent-chat--math-copy-source rendered))
                             (concat "```mermaid\n" body "\n```"))))))
      (when entry (agent-chat--mermaid-finish entry nil "Test cleanup")))))

