(ert-deftest agent-chat-history-startup-cancel-preserves-draft ()
  (agent-chat--with-test-composer
   (insert "Keep this draft")
   (let ((session (agent-chat--session-create :buffer (current-buffer)
                                             :cwd default-directory :startup '(:action select)))
         callback retried)
     (setq agent-chat--session session)
     (cl-letf (((symbol-function 'run-at-time)
                (lambda (_time _repeat function &rest _) (setq callback function)))
               ((symbol-function 'completing-read) (lambda (&rest _) (signal 'quit nil)))
               ((symbol-function 'agent-chat--new-session)
                (lambda (_) (ert-fail "Cancel must not create a session")))
               ((symbol-function 'agent-chat--load-session)
                (lambda (&rest _) (ert-fail "Cancel must not load a session"))))
       (agent-chat--select-session session nil t)
       (funcall callback)
       (should (eq (agent-chat--session-phase session) 'selecting))
       (should-not (agent-chat--state-history agent-chat--state))
       (cl-letf (((symbol-function 'agent-chat--workspace-buffer)
                  (lambda (&rest _) (current-buffer)))
                 ((symbol-function 'agent-chat--list-history)
                  (lambda (same-session cursor include-new &rest _)
                    (should (eq same-session session))
                    (should-not cursor)
                    (should include-new)
                    (setq retried t))))
         (dolist (phase '(selecting failed))
           (setq retried nil)
           (setf (agent-chat--session-phase session) phase)
           (agent-chat)
           (should retried)))
       (should (eq agent-chat--session session))
       (should (equal (buffer-string) "Keep this draft"))))))

