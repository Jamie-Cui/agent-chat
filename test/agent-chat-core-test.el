    (setf (agent-chat--state-cancel state) (lambda () (cl-incf cancelled)))
    (let ((buffer (generate-new-buffer " *agent-chat-cleanup*")))
      (unwind-protect
          (with-current-buffer buffer
            (agent-chat-mode)
            (agent-chat--attach state nil "Test")
            (agent-chat--sync-spinner)
            (setq timer agent-chat--spinner-timer)
            (should (timerp timer)))
        (kill-buffer buffer)))
    (should-not (memq timer timer-list))
    (should (= cancelled 1))
    (should (eq (agent-chat--state-status state) 'cancelled))))

(ert-deftest agent-chat-running-header-animates-without-redrawing-history ()
  (agent-chat--with-test-composer
   (insert "Draft stays here")
   (goto-char 4)
   (setq agent-chat--session
         (agent-chat--session-create :buffer (current-buffer) :phase 'ready))
   (setf (agent-chat--state-status agent-chat--state) 'running)
   (agent-chat--publish)
   (let ((timer agent-chat--spinner-timer)
         (header (agent-chat--header-line))
         (decoration (agent-chat--test-history-string))
         (draft (buffer-string)) (cursor (point)) (undo buffer-undo-list))
     (should (timerp timer))
     (should (string-match-p "Running" (nth 2 header)))
     (agent-chat--sync-spinner)
     (should (eq timer agent-chat--spinner-timer))
     (cl-letf (((symbol-function 'agent-chat--redraw)
                (lambda () (ert-fail "Animation must not redraw history"))))
       (agent-chat--spinner-tick (current-buffer)))
     (should-not (equal header (agent-chat--header-line)))
     (should (equal decoration (agent-chat--test-history-string)))
     (should (equal draft (buffer-string)))
     (should (= cursor (point)))
     (should (eq undo buffer-undo-list))
     ;; A waiting approval takes precedence, and resolving it resumes animation.
     (setf (agent-chat--session-permissions agent-chat--session) '((1 . pending)))
     (agent-chat--sync-spinner)
     (should-not agent-chat--spinner-timer)
     (should-not (memq timer timer-list))
     (should (string-match-p "Approval" (nth 2 (agent-chat--header-line))))
     (setf (agent-chat--session-permissions agent-chat--session) nil)
     (agent-chat--sync-spinner)
     (should (timerp agent-chat--spinner-timer))
     (dolist (status '(idle cancelled failed))
       (setf (agent-chat--state-status agent-chat--state) status)
       (agent-chat--publish)
       (should-not agent-chat--spinner-timer)
       (should-not (string-match-p "Running" (nth 2 (agent-chat--header-line)))))
     ;; Major-mode changes must also release buffer-owned timers.
     (setf (agent-chat--state-status agent-chat--state) 'running)
     (agent-chat--sync-spinner)
     (setq timer agent-chat--spinner-timer)
     (text-mode)
     (should-not (memq timer timer-list)))))

