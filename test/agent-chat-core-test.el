(ert-deftest agent-chat-message-layout-matches-whole-transcript ()
  (agent-chat--with-test-composer
   (let ((agent-chat-render-math nil)
         (agent-chat-process-groups-expand-by-default t)
         (agent-chat--expanded '(2 3)))
     (setf (agent-chat--state-history agent-chat--state)
           '((:role user :text "\u3042\u3044 prompt\n\n@src/main.rs:12\n")
             (:role assistant :text "# Heading\n**Bold** and `code` [file](src/main.rs:12).\n\n| Column | Value |\n|---|---|\n| \u3042\u3044 | long value |\n\n```elisp\n(message \"hi\")\n```\n\n")
             (:role reasoning :text "Thought\nMore thoughts")
             (:role tool :text "Check" :detail "Output\nsecond line" :tool-status "failed")
             (:role permission :text "Allow?" :request-id 2 :options (((optionId . "yes") (name . "Yes"))))
             (:role assistant :text "Final paragraph \u3042\u3044 mixed text.")))
     (setq agent-chat--render-cache nil)
     (let* ((window (selected-window))
            (key (agent-chat--history-key window))
            (ebox-viewport-width (car key)) (ebox-viewport-height 1)
            (ebox--measure-buffer (current-buffer))
            (agent-chat--math-window window)
            (agent-chat--markdown-width (cadr key))
            (whole (agent-chat--render-text-lines
                    (agent-chat--transcript agent-chat--state)))
            (blocks (agent-chat--history-lines window)))
       (let ((expected (string-join whole "\n")) (actual (string-join blocks "\n")))
         ;; Block navigation adds semantic anchors, not visible formatting.
         (remove-text-properties 0 (length actual) '(agent-chat-block-start nil) actual)
         (should (equal-including-properties expected actual)))))))

(ert-deftest agent-chat-message-layout-reuses-and-invalidates-blocks ()
  (agent-chat--with-test-composer
   (let ((render (symbol-function 'agent-chat--render-text-lines)) (calls 0))
     (setf (agent-chat--state-history agent-chat--state)
           (append (cl-loop for i below 20 collect (list :role 'assistant :text (format "Answer %d" i)))
                   (list (list :role 'tool :text "Read" :detail "old" :tool-status "running")
                         (list :role 'assistant :text "Streaming"))))
     (cl-letf (((symbol-function 'agent-chat--render-text-lines)
                (lambda (text) (cl-incf calls) (funcall render text))))
       (agent-chat--publish)
       (should (= calls 22))
       ;; Unchanged publishes and status transitions reuse every block.
       (setq calls 0)
       (agent-chat--publish)
       (should (= calls 0))
       (setf (plist-get (car (last (agent-chat--state-history agent-chat--state))) :text)
             "Streaming delta")
       (agent-chat--publish)
       (should (= calls 1))
       ;; Tool completion mutates an older entry, not necessarily the tail.
       (setf (plist-get (nth 20 (agent-chat--state-history agent-chat--state)) :tool-status)
             "failed")
       (agent-chat--publish)
       (should (= calls 2))
       (setf (alist-get 20 agent-chat--process-group-overrides) t)
       (setq agent-chat--expanded '(20))
       (agent-chat--publish)
       (should (= calls 3))
       ;; Font/geometry changes must invalidate measured rows.
       (let ((face-remapping-alist '((default (:height 1.2) default))))
         (agent-chat--redraw)
         (should (= calls 25)))
       ;; Replacing history cannot retain removed or unrelated entries.
       (setf (agent-chat--state-history agent-chat--state)
             '((:role user :text "New conversation")))
       (agent-chat--publish)
       (should (= (hash-table-count (cdr agent-chat--render-block-cache)) 1))))))

(ert-deftest agent-chat-stream-refresh-coalesces-and-flushes-completion ()
  (agent-chat--with-test-composer
   (insert "unsent draft")
   (let ((agent-chat-stream-refresh-interval 10)
         (renders 0) emit shown timer)
     (cl-letf (((symbol-function 'agent-chat--redraw)
                (lambda ()
                  (cl-incf renders)
                  (setq shown (agent-chat--transcript agent-chat--state)
                        agent-chat--render-cache '(unchanged-cache)))))
       (agent-chat--submit
        agent-chat--state
        (lambda (_request callback) (setq emit callback) #'ignore)
        "Start" default-directory)
       (dotimes (_ 50) (funcall emit '(:type delta :text "x")))
       (setq timer agent-chat--render-timer)
       (should (timerp timer))
       (should (= renders 1))
       (should (equal agent-chat--render-cache '(unchanged-cache)))
       (should-not (string-match-p "xxx" shown))
       (agent-chat--flush-render)
       (should (= renders 2))
       (should (string-match-p (make-string 50 ?x) shown))
       (should-not (memq timer timer-list))
       (funcall emit '(:type delta :text "END"))
       (should (timerp agent-chat--render-timer))
       (funcall emit '(:type done))
       (should (= renders 3))
       (should-not agent-chat--render-timer)
       (should (string-match-p "END" shown))
       (should (equal (buffer-string) "unsent draft"))))))

