(ert-deftest agent-chat-permission-auto-waits-for-selected-window ()
  (let ((agent-chat--permission-auto-queue nil)
        (agent-chat--permission-auto-timer nil)
        (overriding-terminal-local-map nil)
        (overriding-local-map nil) (executing-kbd-macro nil) shown)
    (agent-chat--with-test-session
     (setf (agent-chat--session-busy session) t)
     (let ((owner (current-buffer)))
       (with-temp-buffer
         (switch-to-buffer (current-buffer))
         (cl-letf (((symbol-function 'input-pending-p) #'ignore)
                   ((symbol-function 'transient-setup)
                    (lambda (_prefix _layout _edit &rest args)
                      (push (plist-get args :scope) shown))))
           ;; A process callback's current buffer is not necessarily selected.
           (with-current-buffer owner
             (agent-chat--incoming-request session (agent-chat--test-permission))
             (agent-chat--permission-auto-show))
           (should-not shown)
           (should (eq (current-buffer) (window-buffer (selected-window))))
           (should (= 1 (length agent-chat--permission-auto-queue)))
           (let ((background (split-window-right)))
             (set-window-buffer background owner)
             (agent-chat--permission-auto-show)
             (should-not shown)
             (should-not (eq background (selected-window)))
             (select-window background)
             (agent-chat--permission-auto-show)
             (should (= 1 (length shown)))
             (should (eq session (plist-get (car shown) :session)))
             (should (eq background (selected-window)))
             (should-not agent-chat--permission-auto-queue)
             (should-not agent-chat--permission-auto-timer))))))))

