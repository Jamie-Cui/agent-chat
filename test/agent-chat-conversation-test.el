(ert-deftest agent-chat-conversation-fork-captures-source-without-copying-live-state ()
  (dolist (pane '(prompt history))
    (agent-chat-native-with-view
      (let* ((session (agent-chat-conversation-test-session owner))
             (queue (list (list :id 'q :draft "pending"))) captured)
        (setq agent-chat--queue queue agent-chat--queue-paused "Paused"
              agent-chat--permission-bypass-session session
              agent-chat--client-maker-override :external)
        (insert "unsent")
        (select-window (if (eq pane 'prompt) prompt history))
        (cl-letf (((symbol-function 'agent-chat--start)
                   (lambda (&rest args) (setq captured args))))
          (agent-chat-fork))
        (let ((startup (nth 3 captured)))
          (should (equal (car captured) 'codex))
          (should (equal (plist-get startup :id) "parent"))
          (should (eq (plist-get startup :action) 'fork))
          (should (eq (plist-get startup :backend) :external)))
        (should (eq queue (buffer-local-value 'agent-chat--queue owner)))
        (should (eq session (buffer-local-value 'agent-chat--permission-bypass-session owner)))
        (should (equal "unsent" (with-current-buffer owner (buffer-string))))
        (should (equal (agent-chat--session-id session) "parent"))
        (setf (agent-chat--session-phase session) 'failed)
        (should-error (agent-chat-fork) :type 'user-error)
        (setf (agent-chat--session-phase session) 'ready
              (agent-chat--session-capabilities session) nil)
        (should-error (agent-chat-fork) :type 'user-error)))))

(ert-deftest agent-chat-conversation-fork-loads-once-and-isolates-replay ()
  (agent-chat-native-with-view
    (let ((session (agent-chat-conversation-test-session owner)) methods)
      (setf (agent-chat--session-id session) nil
            (agent-chat--session-phase session) 'connecting
            (agent-chat--session-startup session) '(:action fork :id "parent" :forked-from "parent"))
      (cl-letf (((symbol-function 'acp-send-request)
                 (lambda (&rest args)
                   (let* ((request (plist-get args :request)) (method (map-elt request :method))
                          (success (plist-get args :on-success)))
                     (push method methods)
                     (pcase method
                       ("session/fork" (funcall success '((sessionId . "child"))))
                       ("session/load"
                        (should (equal (map-nested-elt request '(:params sessionId)) "child"))
                        (dolist (id '("parent" "child"))
                          (agent-chat--notification
                           session `((method . "session/update")
                                     (params . ((sessionId . ,id)
                                                (update . ((sessionUpdate . "agent_message_chunk")
                                                           (content . ((type . "text") (text . ,id))))))))))
                        (funcall success nil)))))))
        (agent-chat--fork-session session))
      (should (equal (reverse methods) '("session/fork" "session/load")))
      (should (eq (agent-chat--session-phase session) 'ready))
      (should (equal (agent-chat--session-id session) "child"))
      (should (equal (mapcar (lambda (entry) (plist-get entry :text))
                            (agent-chat--state-history agent-chat--state)) '("child")))
      (should-not agent-chat--permission-bypass-session))))

