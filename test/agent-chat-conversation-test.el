(ert-deftest agent-chat-conversation-running-fork-slash-is-immediate ()
  (agent-chat-native-with-view
    (let ((session (agent-chat-conversation-test-session owner)) startup)
      (setf (agent-chat--session-busy session) t
            (agent-chat--state-status agent-chat--state) 'running)
      (insert "/fork")
      (cl-letf (((symbol-function 'agent-chat--start)
                 (lambda (_agent _directory _scope action) (setq startup action)))
                ((symbol-function 'agent-chat--cancel)
                 (lambda (&rest _) (ert-fail "Slash fork must not cancel"))))
        (agent-chat-submit))
      (should (eq (plist-get startup :action) 'fork))
      (should-not agent-chat--queue)
      (should (string-empty-p (buffer-string)))
      (should (agent-chat--session-busy session))
      (should (eq (agent-chat--state-status agent-chat--state) 'running)))))

