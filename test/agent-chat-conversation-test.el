;;; agent-chat-conversation-test.el --- Conversation routing and forks -*- lexical-binding: t; no-byte-compile: t; -*-

;; Synthetic conversations only: no real prompts or session history are used.
(require 'ert)
(require 'codex-acp)
(require 'agent-chat-native-window-test)

(defun agent-chat-conversation-test-session (owner)
  "Install an idle synthetic session in OWNER."
  (with-current-buffer owner
    (setq agent-chat--session
          (agent-chat--session-create
           :buffer owner :agent 'codex :cwd default-directory :id "parent" :phase 'ready
           :capabilities `((loadSession . t)
                           (sessionCapabilities . ((fork . ,(make-hash-table)))))))))

(ert-deftest agent-chat-conversation-direct-load-and-reuse ()
  (agent-chat-native-with-view
    (let* ((source (agent-chat-conversation-test-session owner))
           (agent-chat-codex-local-backend 'external)
           (agent-chat-agents
            '((codex :name "Test" :client-maker
                     (lambda (buf) (acp-make-client :context-buffer buf :command "test-agent")))))
           calls child)
      (setf (agent-chat--session-busy source) t)
      (insert "unsent draft")
      (select-window history)
      (should-error (agent-chat-load-session "  ") :type 'user-error)
      (unwind-protect
          (cl-letf (((symbol-function 'acp-send-request)
                     (lambda (&rest args)
                       (let* ((request (plist-get args :request))
                              (method (map-elt request :method))
                              (success (plist-get args :on-success)))
                         (push method calls)
                         (pcase method
                           ("initialize" (funcall success '((protocolVersion . 1)
                                                           (agentCapabilities . ((loadSession . t))))))
                           ("session/load"
                            (should (equal "target" (map-nested-elt request '(:params sessionId))))
                            (setq child (plist-get args :buffer))
                            (funcall success '((sessionId . "target"))))
                           (_ (ert-fail method)))))))
            (should (eq (agent-chat-load-session "  target  ") child))
            (should (equal (agent-chat--session-id (buffer-local-value 'agent-chat--session child))
                           "target"))
            (should (eq (agent-chat-load-session "parent") owner))
            (should (equal (buffer-string) "unsent draft"))
            (erase-buffer)
            (insert "/load target")
            (agent-chat-submit)
            (should (eq (window-buffer (selected-window)) child))
            (should (equal (reverse calls) '("initialize" "session/load")))
            (should (agent-chat--session-busy source)))
        (when (buffer-live-p child) (kill-buffer child))))))

(ert-deftest agent-chat-conversation-load-picker-selects-types-or-cancels ()
  (dolist (choice '("Same title · parent" "Same title · other" "  unlisted  " quit))
    (agent-chat-native-with-view
      (let* ((source (agent-chat-conversation-test-session owner))
             (agent-chat-codex-local-backend 'external)
             (agent-chat-agents '((codex :client-maker
                                         (lambda (buf) (acp-make-client :context-buffer buf :command "fixture")))))
             (listed (not (equal choice "  unlisted  ")))
             (capabilities (if listed '((loadSession . t) (sessionCapabilities (list)))
                             '((loadSession . t))))
             (schedule (symbol-function 'run-at-time))
             picker read-choice loaded)
        (insert "keep my draft")
        (setf (agent-chat--session-busy source) t)
        (select-window history)
        (unwind-protect
            (cl-letf (((symbol-function 'run-at-time)
                       (lambda (time repeat fn &rest args)
                         (if (and (eq time 0) (null repeat))
                             (setq read-choice (lambda () (apply fn args)))
                           (apply schedule time repeat fn args))))
                      ((symbol-function 'completing-read)
                       (lambda (_prompt table _pred require-match &rest _)
                         (should-not require-match)
                         (should (equal (all-completions "" table)
                                        (when listed '("Same title · parent" "Same title · other"))))
                         (if (eq choice 'quit) (signal 'quit nil) choice)))
                      ((symbol-function 'acp-send-request)
                       (lambda (&rest args)
                         (let ((req (plist-get args :request)) (ok (plist-get args :on-success)))
                           (pcase (map-elt req :method)
                             ("initialize" (funcall ok `((protocolVersion . 1)
                                                         (agentCapabilities . ,capabilities))))
                             ("session/list" (funcall ok '((sessions . [((title . "Same title") (sessionId . "parent"))
                                                                         ((title . "Same title") (sessionId . "other"))]))))
                             ("session/load" (push (map-nested-elt req '(:params sessionId)) loaded)
                              (funcall ok nil))
                             (_ (ert-fail (map-elt req :method))))))))
              (setq picker (call-interactively #'agent-chat-load-session))
              (should (eq (selected-window) history))
              (funcall read-choice)
              (cond
               ((eq choice 'quit) (should-not (buffer-live-p picker))
                (should (eq (selected-window) history)) (should-not loaded))
               ((equal choice "Same title · parent")
                (should-not (buffer-live-p picker))
                (should (eq (window-buffer (selected-window)) owner)) (should-not loaded))
               (t (should (equal loaded (list (if listed "other" "unlisted"))))
                  (should (eq (window-buffer (selected-window)) picker))))
              (should (agent-chat--session-busy source))
              (should (equal (with-current-buffer owner (buffer-string)) "keep my draft")))
          (when (buffer-live-p picker) (kill-buffer picker)))))))

(ert-deftest agent-chat-conversation-direct-load-selects-native-backend-only-in-project ()
  (dolist (thread-cwd '("/work/" "/other/"))
    (with-temp-buffer
      (let* ((state (codex-acp--state-create :initialized t :directory "/work/"
                                             :local-directory "/control/"))
             (client (list (cons :codex-acp-state state)))
             (session (agent-chat--session-create :buffer (current-buffer) :agent 'codex
                                                  :cwd "/work/" :client client
                                                  :capabilities '((loadSession . t))))
             handed-off)
        (setq agent-chat--session session agent-chat--state (agent-chat--state-create))
        (cl-letf (((symbol-function 'acp-send-request) #'codex-acp--request)
                  ((symbol-function 'codex-acp--rpc)
                   (lambda (_ method params success _failure)
                     (should (equal method "thread/read"))
                     (should (equal "saved" (map-elt params 'threadId)))
                     (funcall success `((thread . ((id . "saved") (cwd . ,thread-cwd)))))))
                  ((symbol-function 'agent-chat--load-native-codex-session)
                   (lambda (s id) (setq handed-off (list s id)))))
          (agent-chat--load-session session "saved"))
        (if (equal thread-cwd "/work/")
            (should (equal handed-off (list session "saved")))
          (should-not handed-off)
          (should (eq (agent-chat--session-phase session) 'failed)))))))

(ert-deftest agent-chat-conversation-controls-use-owner-from-either-pane ()
  (dolist (pane '(prompt history))
    (agent-chat-native-with-view
      (let ((session (agent-chat-conversation-test-session owner)) called)
        (select-window (if (eq pane 'prompt) prompt history))
        (let ((window (selected-window)) (position (point)))
          (cl-letf (((symbol-function 'agent-chat--cancel)
                     (lambda (state) (setq called (list (current-buffer) state)))))
            (agent-chat-interrupt))
          (should (eq (car called) owner))
          (should (eq (cadr called) (buffer-local-value 'agent-chat--state owner)))
          (with-current-buffer owner
            (setq agent-chat--queue '((:id first :draft "pending"))
                  agent-chat--queue-paused "Paused"))
          (cl-letf (((symbol-function 'agent-chat--queue-schedule) #'ignore))
            (agent-chat-queue-resume))
          (should-not (buffer-local-value 'agent-chat--queue-paused owner))
          (agent-chat-queue-clear)
          (should-not (buffer-local-value 'agent-chat--queue owner))
          (setf (agent-chat--session-permissions session) '((1 . request)))
          (cl-letf (((symbol-function 'agent-chat--permission-request-menu)
                     (lambda (target _request) (setq called (list (current-buffer) target))))
                    ((symbol-function 'agent-chat--permission-toggle-bypass)
                     (lambda (target &rest _) (setq called (list (current-buffer) target)))))
            (dolist (command '(agent-chat-permissions agent-chat-toggle-permission-bypass))
              (call-interactively command)
              (should (equal called (list owner session)))))
          (setf (agent-chat--session-permissions session) nil)
          (cl-letf (((symbol-function 'agent-chat--flush-render)
                     (lambda (&rest _) (setq called (current-buffer)))))
            (agent-chat-revert-buffer)
            (should (eq called owner)))
          (should (eq window (selected-window)))
          (should (= position (point))))))))

