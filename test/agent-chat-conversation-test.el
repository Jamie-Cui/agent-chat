(ert-deftest agent-chat-conversation-locked-load-can-fork-or-retry-same-id ()
  (agent-chat-native-with-view
    (let* ((session (agent-chat-conversation-test-session owner))
           (caps (agent-chat--session-capabilities session))
           (locked t) loads fork)
      (setf (agent-chat--session-startup session) '(:action select)
            (agent-chat--session-id session) nil)
      (setq agent-chat--client-maker-override
            (lambda (buf) (acp-make-client :context-buffer buf :command "test-agent")))
      (insert "unsent draft")
      (cl-letf (((symbol-function 'acp-send-request)
                 (lambda (&rest args)
                   (let ((request (plist-get args :request))
                         (success (plist-get args :on-success)))
                     (pcase (map-elt request :method)
                       ("initialize" (funcall success `((protocolVersion . 1)
                                                       (agentCapabilities . ,caps) (authMethods . []))))
                       ("session/load"
                        (push (map-nested-elt request '(:params sessionId)) loads)
                        (if locked (funcall (plist-get args :on-failure)
                                            '((message . "thread parent already has an active writer")))
                          (funcall success '((sessionId . "parent")))))
                       (_ (ert-fail (map-elt request :method)))))))
                ((symbol-function 'acp-shutdown) #'ignore))
        (agent-chat--load-session session "parent")
        (select-window history)
        (should-not (agent-chat--authentication-available-p))
        (should (string-match-p "already has an active writer.*retry the same session"
                                (error-message-string (should-error (agent-chat-submit) :type 'user-error))))
        (cl-letf (((symbol-function 'agent-chat--start)
                   (lambda (_agent _dir _scope startup) (setq fork startup))))
          (agent-chat-fork))
        (should (eq 'fork (plist-get fork :action)))
        (should (equal "parent" (plist-get fork :id)))
        (select-window history)
        (agent-chat-reconnect)
        (should (eq 'failed (agent-chat--session-phase (buffer-local-value 'agent-chat--session owner))))
        (setq locked nil)
        (agent-chat-reconnect)
        (with-current-buffer owner
          (should (eq 'ready (agent-chat--session-phase agent-chat--session)))
          (should (equal "parent" (agent-chat--session-id agent-chat--session)))
          (should (equal (buffer-string) "unsent draft"))
          (setf (agent-chat--session-client agent-chat--session) nil))
        (should (equal loads '("parent" "parent" "parent")))))))

