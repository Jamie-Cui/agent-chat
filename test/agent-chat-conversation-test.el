(ert-deftest agent-chat-conversation-real-help-menu-from-either-pane ()
  (skip-unless (display-graphic-p))
  (dolist (pane '(prompt history))
    (agent-chat-native-with-view
      (let ((session (agent-chat-conversation-test-session owner)))
        (setf (agent-chat--session-phase session) 'failed
              (agent-chat--session-id session) nil
              (agent-chat--session-startup session) '(:action load :id "locked-parent"))
        (select-window (if (eq pane 'prompt) prompt history))
        (let ((origin (selected-window)))
          (unwind-protect
              (progn
                (agent-chat-help)
                (should (transient-active-prefix 'agent-chat-help))
                (should (equal (transient-scope 'agent-chat-help) (cons owner session)))
                (should (eq origin (selected-window)))
                (should (transient-get-suffix 'agent-chat-help "f"))
                (transient--show)
                (with-current-buffer transient--buffer-name
                  (should (string-search "Retry same session" (buffer-string)))
                  (should-not (string-search "Reconnect (new session)" (buffer-string)))
                  (should-not (string-search "Authenticate" (buffer-string)))))
            (when (transient-active-prefix 'agent-chat-help)
              (transient--emergency-exit :test-finished))))))))

(ert-deftest agent-chat-conversation-running-fork-keeps-source-streaming ()
  (dolist (pane '(prompt history))
    (dolist (load-fails '(nil t))
      (agent-chat-native-with-view
        (let* ((session (agent-chat-conversation-test-session owner))
               (client (list :fixture 'source))
               (permissions (list (cons 1 'pending-approval)))
               (queued (list (list :id 'pending :draft "queued")))
               (options '(((id . "model") (category . "model") (type . "select")
                            (currentValue . "m") (options . [((value . "m"))]))
                           ((id . "effort") (category . "thought_level") (type . "select")
                            (currentValue . "high") (options . [((value . "high"))]))))
               received
               (emit (lambda (event) (setq received event)))
               fork-success child-session child requests)
          (setq agent-chat--queue queued agent-chat--queue-paused nil
                agent-chat--permission-bypass-session session
                agent-chat--client-maker-override (lambda (_buffer) (list :fixture 'child)))
          (setf (agent-chat--session-client session) client
                (agent-chat--session-busy session) t
                (agent-chat--session-permissions session) permissions
                (agent-chat--session-config-options session) options
                (agent-chat--session-emit session) emit
                (agent-chat--state-status agent-chat--state) 'running)
          (insert "unsent draft")
          (select-window (if (eq pane 'prompt) prompt history))
          (unwind-protect
              (cl-letf (((symbol-function 'agent-chat--connect)
                         (lambda (new-session)
                           (setq child-session new-session)
                           (setf (agent-chat--session-capabilities new-session)
                                 (agent-chat--session-capabilities session))
                           (agent-chat--fork-session new-session)))
                        ((symbol-function 'acp-send-request)
                         (lambda (&rest args)
                           (should-not (eq (plist-get args :client) client))
                           (let ((method (map-elt (plist-get args :request) :method)))
                             (push method requests)
                             (pcase method
                               ("session/fork" (setq fork-success (plist-get args :on-success)))
                               ("session/load"
                                (if load-fails
                                    (funcall (plist-get args :on-failure) '((message . "Fixture load failed")))
                                  (funcall (plist-get args :on-success) `((configOptions . ,options)))))
                               (_ (ert-fail (format "Unexpected request: %s" method)))))))
                        ((symbol-function 'agent-chat--cancel)
                         (lambda (&rest _) (ert-fail "Fork must not cancel the source")))
                        ((symbol-function 'agent-chat--disconnect)
                         (lambda (&rest _) (ert-fail "Fork must not disconnect the source"))))
                (setq child (agent-chat-fork))
                (should (buffer-live-p child))
                (should-not (eq (agent-chat--session-client child-session) client))
                (should (equal (plist-get (agent-chat--session-startup child-session) :settings)
                               '(("model" . "m") ("thought_level" . "high"))))
                ;; Streaming continues while the fork is pending and after it settles.
                (dolist (text '("during fork" "after fork"))
                  (when (equal text "after fork")
                    (funcall fork-success '((sessionId . "child"))))
                  (agent-chat--notification
                   session `((method . "session/update")
                             (params . ((sessionId . "parent")
                                        (update . ((sessionUpdate . "agent_message_chunk")
                                                   (content . ((type . "text") (text . ,text)))))))))
                  (should (equal (plist-get received :text) text)))
                (should (equal (reverse requests) '("session/fork" "session/load")))
                (should (eq (agent-chat--session-phase child-session) (if load-fails 'failed 'ready)))
                (should (eq (agent-chat--session-client session) client))
                (should (agent-chat--session-busy session))
                (should-not (agent-chat--session-cancelling session))
                (should (eq (agent-chat--session-emit session) emit))
                (should (eq (agent-chat--session-permissions session) permissions))
                (with-current-buffer owner
                  (should (eq (agent-chat--state-status agent-chat--state) 'running))
                  (should (eq agent-chat--queue queued))
                  (should-not agent-chat--queue-paused)
                  (should (eq agent-chat--permission-bypass-session session))
                  (should (equal (buffer-string) "unsent draft")))
                (with-current-buffer child
                  (should-not agent-chat--queue)
                  (should-not agent-chat--permission-bypass-session)))
            (when (buffer-live-p child)
              (with-current-buffer child
                (let ((kill-buffer-query-functions nil)) (kill-buffer child))))))))))

