(ert-deftest agent-chat-conversation-fork-restores-model-before-effort ()
  (agent-chat-native-with-view
    (let ((session (agent-chat-conversation-test-session owner)) changes)
      (setf (agent-chat--session-phase session) 'connecting
            (agent-chat--session-config-options session)
            '(((id . "model") (category . "model") (type . "select")
               (currentValue . "old") (options . [((value . "new") (name . "New"))]))
              ((id . "effort") (category . "thought_level") (type . "select")
               (currentValue . "low") (options . [((value . "high") (name . "High"))]))))
      (cl-letf (((symbol-function 'acp-send-request)
                 (lambda (&rest args)
                   (let* ((params (map-elt (plist-get args :request) :params))
                          (id (map-elt params 'configId))
                          (options (copy-tree (agent-chat--session-config-options session) t)))
                     (push id changes)
                     (should (eq (agent-chat--session-phase session) 'connecting))
                     (setf (alist-get 'currentValue (seq-find (lambda (option) (equal (map-elt option 'id) id)) options))
                           (map-elt params 'value))
                     (funcall (plist-get args :on-success) `((configOptions . ,options)))))))
        (agent-chat--fork-settings session '(("model" . "new") ("thought_level" . "high"))))
      (should (equal (reverse changes) '("model" "effort")))
      (should (eq (agent-chat--session-phase session) 'ready)))))

