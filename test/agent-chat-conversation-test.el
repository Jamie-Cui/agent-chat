(ert-deftest agent-chat-conversation-backend-fork-and-reload-own-thread ()
  (let* ((state (codex-acp--state-create :initialized t :directory "/ssh:fixture:/project/"
                                       :local-directory "/tmp/fixture-control/"))
         (client (list (cons :codex-acp-state state))) requests replayed result)
    (setf (codex-acp--state-client state) client)
    (cl-letf (((symbol-function 'codex-acp--rpc)
               (lambda (_state method params success _failure &rest _)
                 (push (cons method params) requests)
                 (pcase method
                   ("thread/read" (funcall success `((thread . ((id . ,(map-elt params 'threadId))
                                                               (cwd . "/tmp/fixture-control/"))))))
                   ("thread/fork" (funcall success '((thread . ((id . "child"))) (model . "m"))))
                   ("thread/resume" (funcall success '((thread . ((id . "child") (turns . [saved]))) (model . "m")))))))
              ((symbol-function 'codex-acp--session-ready)
               (lambda (_state id _model success &rest _) (funcall success `((sessionId . ,id)))))
              ((symbol-function 'codex-acp--replay-thread)
               (lambda (_state thread) (push thread replayed))))
      (dolist (method '("session/fork" "session/load"))
        (codex-acp--request
         :client client :request `((:method . ,method)
                                   (:params . ((sessionId . ,(if (equal method "session/fork") "parent" "child"))
                                               (cwd . "/ssh:fixture:/project/") (mcpServers . []))))
         :on-success (lambda (value) (setq result value)) :on-failure #'ert-fail)))
    (should (equal (reverse (mapcar #'car requests)) '("thread/read" "thread/fork" "thread/read" "thread/resume")))
    (should (equal (map-elt result 'sessionId) "child"))
    (should (equal (codex-acp--state-thread state) "child"))
    (should (= (length replayed) 1))
    (should (equal (map-elt (car replayed) 'turns) [saved]))
    (let ((params (cdr (assoc "thread/fork" requests))))
      (should (equal (map-elt params 'sandbox) "read-only"))
      (should (eq (map-elt params 'excludeTurns) t))
      (should (eq (map-elt (map-elt params 'config) "features.shell_tool") :false))
      (should-not (map-contains-key params 'dynamicTools)))
    (should-not (codex-acp-allowed-directories client))))

(ert-deftest agent-chat-conversation-backend-rejects-cross-workspace-and-invalid-fork ()
  (dolist (scenario '(foreign same-id missing-id busy))
    (let* ((state (codex-acp--state-create :initialized t :directory "/tmp/project/"
                                         :local-directory "/tmp/control/"))
           (client (list (cons :codex-acp-state state))) failure methods)
      (setf (codex-acp--state-client state) client)
      (when (eq scenario 'busy) (setf (codex-acp--state-thread state) "parent"))
      (cl-letf (((symbol-function 'codex-acp--rpc)
                 (lambda (_state method _params success _failure &rest _)
                   (push method methods)
                   (if (equal method "thread/read")
                       (funcall success `((thread . ((cwd . ,(if (eq scenario 'foreign) "/tmp/elsewhere/" "/tmp/control/"))))))
                     (funcall success `((thread . ((id . ,(when (eq scenario 'same-id) "parent"))))))))))
        (codex-acp--request
         :client client :request '((:method . "session/fork")
                                   (:params . ((sessionId . "parent") (cwd . "/tmp/project/"))))
         :on-success (lambda (_) (ert-fail "Unexpected success"))
         :on-failure (lambda (value) (setq failure value))))
      (should failure)
      (when (memq scenario '(foreign busy)) (should-not (member "thread/fork" methods)))
      (unless (eq scenario 'busy) (should-not (codex-acp--state-thread state))))))

