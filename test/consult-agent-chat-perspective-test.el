;;; consult-agent-chat-perspective-test.el --- Perspective picker scope -*- lexical-binding: t; no-byte-compile: t; -*-

(require 'consult)
(require 'perspective)

(require 'agent-chat-mode-line-test)

(ert-deftest consult-agent-chat-perspective-membership-matches-mode-line ()
  (agent-chat-mode-line-test--with-perspectives
    (let* ((first (agent-chat-mode-line-test--conversation " *picker-A*" "/tmp/same/" 'running))
           (second (agent-chat-mode-line-test--conversation " *picker-other-project*" "/ssh:fixture:/other/" 'idle))
           (foreign (agent-chat-mode-line-test--conversation " *picker-B*" "/tmp/same/" 'failed))
           (history (generate-new-buffer " *picker-history*"))
           (queue (generate-new-buffer " *picker-queue*"))
           (dead (generate-new-buffer " *picker-dead*"))
           (a (agent-chat-mode-line-test--perspective "A" (list first second history queue dead first)))
           (b (agent-chat-mode-line-test--perspective "B" (list foreign)))
           (empty (agent-chat-mode-line-test--perspective "empty" nil)))
      (unwind-protect
          (with-current-buffer first
            (with-current-buffer history
              (setq major-mode 'agent-chat-history-mode agent-chat--owner first))
            (with-current-buffer queue (setq major-mode 'agent-chat-queue-mode))
            (kill-buffer dead)
            (set-frame-parameter nil 'persp--curr a)
            (let* ((members (copy-sequence (persp-buffers a)))
                   (entries (consult-agent-chat-buffer--buffers)))
              (should (= 2 (length entries)))
              (should (memq first entries))
              (should (memq second entries))
              (should (equal (persp-buffers a) members))
              (should (= (length entries)
                         (aref (agent-chat-mode-line--collect members) 0))))
            ;; Membership, not the invocation buffer or project, owns scope.
            (set-frame-parameter nil 'persp--curr b)
            (should (equal (consult-agent-chat-buffer--buffers) (list foreign)))
            (persp-add-buffer first)
            (should (= 2 (length (consult-agent-chat-buffer--buffers))))
            (set-frame-parameter nil 'persp--curr a)
            (let ((entries (consult-agent-chat-buffer--buffers)))
              (should (= 2 (length entries)))
              (should (memq first entries))
              (should (memq second entries)))
            (set-frame-parameter nil 'persp--curr empty)
            (should-not (consult-agent-chat-buffer--buffers))
            (should-not (funcall (plist-get consult-agent-chat-source :items)))
            (let ((persp-mode nil))
              (should-not (consult-agent-chat-buffer--buffers))))
        (dolist (buffer (list first second foreign history queue dead))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest consult-agent-chat-perspective-mru-order-is-independent-of-project ()
  (agent-chat-mode-line-test--with-perspectives
    (let* ((a1 (agent-chat-mode-line-test--conversation " *picker-a1*" "/tmp/a/" 'idle))
           (a2 (agent-chat-mode-line-test--conversation " *picker-a2*" "/tmp/a/" 'idle))
           (b1 (agent-chat-mode-line-test--conversation " *picker-b1*" "/tmp/b/" 'idle))
           (b2 (agent-chat-mode-line-test--conversation " *picker-b2*" "/tmp/b/" 'idle))
           (c (agent-chat-mode-line-test--conversation " *picker-c*" "/tmp/c/" 'idle))
           (foreign (agent-chat-mode-line-test--conversation " *picker-foreign*" "/tmp/a/" 'idle))
           (members (list a1 a2 b1 b2 c))
           (perspective (agent-chat-mode-line-test--perspective "work" members)))
      (unwind-protect
          (with-current-buffer a1
            (set-frame-parameter nil 'persp--curr perspective)
            (cl-letf (((symbol-function 'buffer-list)
                       (lambda (&optional _) (list foreign b2 c a2 a1 b1)))
                      ((symbol-function 'project-current)
                       (lambda (&rest _) (ert-fail "Project discovery")))
                      ((symbol-function 'file-truename)
                       (lambda (&rest _) (ert-fail "Filesystem lookup"))))
              (should (equal (consult-agent-chat-buffer--buffers)
                             (list b2 c a2 a1 b1)))))
        (mapc #'kill-buffer (cons foreign members))))))

(ert-deftest consult-agent-chat-perspective-new-belongs-to-current-perspective ()
  (skip-unless (and (display-graphic-p) (not persp-mode)))
  (let* ((foreign (agent-chat-mode-line-test--conversation " *picker-existing*" temporary-file-directory 'running))
         (origin (generate-new-buffer " *picker-empty-source*"))
         (foreign-session (buffer-local-value 'agent-chat--session foreign))
         (persp-suppress-no-prefix-key-warning t)
         (persp-avoid-killing-last-buffer-in-perspective nil)
         (persp-show-modestring nil)
         (agent-chat-mode-line-spinner-interval 3600)
         created)
    (unwind-protect
        (save-window-excursion
          (with-current-buffer foreign
            (insert "Preserve running conversation")
            (setf (agent-chat--session-agent foreign-session) 'codex
                  (agent-chat--session-busy foreign-session) t))
          (persp-mode 1)
          (agent-chat-mode-line-mode 1)
          (persp-switch "picker-original")
          (switch-to-buffer foreign)
          (persp-switch "picker-new")
          (switch-to-buffer origin)
          (setq default-directory temporary-file-directory)
          (let ((noninteractive nil))
            (cl-letf (((symbol-function 'project-current)
                       (lambda (&rest _) (cons 'transient temporary-file-directory)))
                      ((symbol-function 'agent-chat--source-context) #'ignore)
                      ((symbol-function 'agent-chat--redraw) #'ignore)
                      ((symbol-function 'agent-chat--read-agent) (lambda () 'codex))
                      ((symbol-function 'consult--read)
                       (lambda (collection &rest options)
                         (funcall (plist-get options :lookup) "" (funcall collection nil))))
                      ((symbol-function 'agent-chat--begin-connection)
                       (lambda (agent &optional startup)
                         (should (equal startup '(:action select)))
                         (setq created (current-buffer)
                               agent-chat--session
                               (agent-chat--session-create :buffer created :agent agent
                                                           :cwd default-directory :phase 'ready
                                                           :startup startup)))))
              (consult-agent-chat-buffer)
              (should (buffer-live-p created))
              (should (eq (window-buffer (selected-window)) origin))
              (agent-chat--display-session (buffer-local-value 'agent-chat--session created))
              (should (eq (window-buffer (selected-window)) created))
              (should (equal (consult-agent-chat-buffer--buffers) (list created)))
              (should (equal (agent-chat-mode-line--render) " (picker-new: A1) "))
              (persp-switch "picker-original")
              (should (equal (consult-agent-chat-buffer--buffers) (list foreign)))
              (should (equal (agent-chat-mode-line--render) " (picker-original: A1 ⠋) "))
              (should (equal (with-current-buffer foreign (buffer-string)) "Preserve running conversation"))
              (should (agent-chat--session-busy foreign-session))
              (should-not (agent-chat--session-stopped foreign-session)))))
      (agent-chat-mode-line-mode -1)
      (persp-mode -1)
      (dolist (buffer (list created foreign origin))
        (when (buffer-live-p buffer) (kill-buffer buffer))))))

(provide 'consult-agent-chat-perspective-test)
;;; consult-agent-chat-perspective-test.el ends here
