;;; consult-agent-chat-include-test.el --- Include an existing conversation -*- lexical-binding: t; no-byte-compile: t; -*-

(require 'consult)
(require 'perspective)

(require 'ert)
(require 'consult-agent-chat)
(require 'agent-chat-mode-line-test)

(defmacro consult-agent-chat-include-test--workspace (&rest body)
  "Run BODY with member, foreign and unassociated synthetic conversations."
  (declare (indent 0) (debug t))
  `(save-window-excursion
     (agent-chat-mode-line-test--with-perspectives
       (let* ((source (generate-new-buffer " *include-source*"))
              (member (agent-chat-mode-line-test--conversation " *include-member*" "/tmp/local/" 'idle))
              (foreign (agent-chat-mode-line-test--conversation " *include-foreign*" "/ssh:fixture:/remote/" 'running))
              (unassociated (agent-chat-mode-line-test--conversation " *include-unassociated*" "/tmp/" 'idle))
              (history (generate-new-buffer " *include-history*"))
              (queue (generate-new-buffer " *include-queue*"))
              (a (agent-chat-mode-line-test--perspective "A" (list source member)))
              (b (agent-chat-mode-line-test--perspective "B" (list foreign history queue)))
              (session (buffer-local-value 'agent-chat--session foreign)))
         (unwind-protect
             (progn
               (switch-to-buffer source)
               (set-frame-parameter nil 'persp--curr a)
               (with-current-buffer history
                 (setq major-mode 'agent-chat-history-mode agent-chat--owner foreign))
               (with-current-buffer queue
                 (setq major-mode 'agent-chat-queue-mode agent-chat--queue-owner foreign))
               (with-current-buffer foreign
                 (insert "Keep this running session's draft")
                 (setq agent-chat--queue '((:id 1 :draft "Queued prompt"))))
               (setf (agent-chat--session-busy session) t
                     (agent-chat--session-client session) 'inert-client)
               (agent-chat-mode-line-mode 1)
               ,@body)
           (dolist (buffer (list source member foreign unassociated history queue))
             (when (buffer-live-p buffer) (kill-buffer buffer))))))))

(ert-deftest consult-agent-chat-include-keeps-session-and-other-memberships ()
  (consult-agent-chat-include-test--workspace
    (let ((reads 0)
          (multi (symbol-function 'consult--multi))
          (before-b (copy-sequence (persp-buffers b))))
      (cl-letf (((symbol-function 'consult--multi)
                 (lambda (sources &rest options)
                   (when (= reads 1)
                     (should (equal (plist-get options :prompt) "Include Agent Chat buffer: "))
                     (should (= 1 (length sources)))
                     (should-not (plist-get (car sources) :state)))
                   (apply multi sources options)))
                ((symbol-function 'consult--read)
                 (lambda (collection &rest options)
                   (cl-incf reads)
                   (let* ((candidates (funcall collection nil))
                          (chosen
                           (if (= reads 1)
                               (cl-find-if (lambda (c) (string-prefix-p "Include agent-chat buffer" c)) candidates)
                             (cl-find-if (lambda (c) (eq foreign (cdr (get-text-property 0 'multi-category c)))) candidates))))
                     (should chosen)
                     (should-not (memq foreign (persp-buffers a)))
                     (when (= reads 2)
                       (should (= 2 (length candidates)))
                       (should (eq (plist-get options :require-match) t))
                       (should-not (plist-get options :state)))
                     (funcall (plist-get options :lookup) chosen candidates)))))
        (consult-agent-chat-buffer))
      (should (= reads 2))
      (should (equal before-b (persp-buffers b))))
    (dolist (view (list foreign history queue))
      (should (memq view (persp-buffers a)))
      (should (memq view (persp-buffers b))))
    (should-not (memq unassociated (persp-buffers a)))
    (should (memq member (consult-agent-chat-buffer--buffers)))
    (should (memq foreign (consult-agent-chat-buffer--buffers)))
    (should (= 2 (length (consult-agent-chat-buffer--buffers))))
    (should (equal (agent-chat-mode-line--render) " (A: A2 ⠋) "))
    (should (eq (window-buffer (selected-window)) source))
    (should (eq session (buffer-local-value 'agent-chat--session foreign)))
    (should (agent-chat--session-busy session))
    (should (eq (agent-chat--session-client session) 'inert-client))
    (should-not (agent-chat--session-stopped session))
    (with-current-buffer foreign
      (should (equal default-directory "/ssh:fixture:/remote/"))
      (should (equal (buffer-string) "Keep this running session's draft"))
      (should (equal agent-chat--queue '((:id 1 :draft "Queued prompt")))))))

(ert-deftest consult-agent-chat-include-cancel-preserves-membership ()
  (consult-agent-chat-include-test--workspace
    (let ((before-a (copy-sequence (persp-buffers a)))
          (before-b (copy-sequence (persp-buffers b)))
          (reads 0) cancelled)
      (cl-letf (((symbol-function 'consult--read)
                 (lambda (collection &rest options)
                   (cl-incf reads)
                   (when (= reads 2) (signal 'quit nil))
                   (let* ((candidates (funcall collection nil))
                          (chosen (cl-find-if (lambda (c) (string-prefix-p "Include agent-chat buffer" c)) candidates)))
                     (should chosen)
                     (funcall (plist-get options :lookup) chosen candidates)))))
        (condition-case nil (consult-agent-chat-buffer) (quit (setq cancelled t))))
      (should cancelled)
      (should (= reads 2))
      (should (equal before-a (persp-buffers a)))
      (should (equal before-b (persp-buffers b))))))

(ert-deftest consult-agent-chat-include-can-restore-unassociated-conversation ()
  (consult-agent-chat-include-test--workspace
    (cl-letf (((symbol-function 'consult--read)
               (lambda (collection &rest options)
                 (let* ((candidates (funcall collection nil))
                        (chosen (cl-find-if (lambda (c) (eq unassociated (cdr (get-text-property 0 'multi-category c)))) candidates)))
                   (should chosen)
                   (funcall (plist-get options :lookup) chosen candidates)))))
      (consult-agent-chat-buffer--include a))
    (should (memq unassociated (persp-buffers a)))
    (should-not (memq unassociated (persp-buffers b)))))

(ert-deftest consult-agent-chat-include-rejects-changed-perspective ()
  (consult-agent-chat-include-test--workspace
    (let ((before-a (copy-sequence (persp-buffers a)))
          (before-b (copy-sequence (persp-buffers b))))
      (cl-letf (((symbol-function 'consult--read)
                 (lambda (collection &rest options)
                   (prog1 (funcall (plist-get options :lookup) "" (funcall collection nil))
                     (set-frame-parameter nil 'persp--curr b)))))
        (should-error (consult-agent-chat-buffer--include a) :type 'user-error))
      (should (equal before-a (persp-buffers a)))
      (should (equal before-b (persp-buffers b))))))

(ert-deftest consult-agent-chat-include-rejects-killed-conversation ()
  (consult-agent-chat-include-test--workspace
    (let ((before (copy-sequence (persp-buffers a))))
      (cl-letf (((symbol-function 'consult--read)
                 (lambda (collection &rest options)
                   (let* ((candidates (funcall collection nil))
                          (chosen (cl-find-if (lambda (c) (eq unassociated (cdr (get-text-property 0 'multi-category c)))) candidates))
                          (selected (funcall (plist-get options :lookup) chosen candidates)))
                     (kill-buffer unassociated)
                     selected))))
        (should-error (consult-agent-chat-buffer--include a) :type 'user-error))
      (should (equal before (persp-buffers a))))))

(ert-deftest consult-agent-chat-include-requires-perspective-and-candidates ()
  (consult-agent-chat-include-test--workspace
    (cl-letf (((symbol-function 'buffer-list) (lambda (&optional _) (list source member)))
              ((symbol-function 'consult--multi) (lambda (&rest _) (ert-fail "No candidates"))))
      (should-error (consult-agent-chat-buffer--include a) :type 'user-error))
    (let ((persp-mode nil))
      (should-error (consult-agent-chat-buffer--include a) :type 'user-error))))

(provide 'consult-agent-chat-include-test)
;;; consult-agent-chat-include-test.el ends here
