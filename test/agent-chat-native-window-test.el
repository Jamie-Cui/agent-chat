      (should (window-live-p prompt))
      (should (window-live-p history))
      (delete-window)
      (should (= 1 (length (window-list))))
      (should-not (get-buffer-window owner))
      (should-not (get-buffer-window messages))
      (should (buffer-live-p owner))))
  (dolist (target '(prompt history))
    (agent-chat-native-with-view
      (select-window (if (eq target 'prompt) prompt history))
      (delete-window)
      (should (= 1 (length (window-list))))
      (should-not (window-live-p prompt))
      (should-not (window-live-p history))
      (should (buffer-live-p owner))
      (should (buffer-live-p messages)))))

(ert-deftest agent-chat-native-pair-excludes-vertical-editing-sibling ()
  (save-window-excursion
    (let ((owner (generate-new-buffer " *agent-chat-vertical-draft*"))
          (source (generate-new-buffer " *agent-chat-vertical-source*"))
          (agent-chat-render-math nil)
          (agent-chat-render-mermaid nil))
      (unwind-protect
          (progn
            (delete-other-windows)
            (switch-to-buffer source)
            (let ((editing (selected-window)))
              (select-window (split-window-below))
              (switch-to-buffer owner)
              (agent-chat-mode)
              (agent-chat--attach (agent-chat--state-create) nil "Vertical test")
              (agent-chat--redraw)
              (should-not (window-atom-root editing))
              (select-window editing)
              (delete-other-windows)
              (should (equal (window-list) (list editing)))
              (should (eq (window-buffer editing) source))))
        (when (buffer-live-p owner)
          (with-current-buffer owner
            (let ((kill-buffer-query-functions nil)) (kill-buffer owner))))
        (kill-buffer source)))))

(ert-deftest agent-chat-native-input-grows-bounds-shrinks-and-keeps-undo ()
