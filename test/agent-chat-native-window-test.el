(ert-deftest agent-chat-native-block-bindings-are-reading-only ()
  (agent-chat-native-with-view
    (let ((next (key-binding (kbd "C-n"))) (previous (key-binding (kbd "C-p")))
          (tab (key-binding (kbd "TAB"))))
      (agent-chat-native-blocks owner)
      (select-window history)
      (goto-char (point-min))
      (search-forward "Example")
      (backward-char)
      (dolist (state '(normal motion visual emacs))
        (evil-change-state state)
        (should (eq (key-binding (kbd "C-n")) #'agent-chat-history-next-block))
        (should (eq (key-binding (kbd "C-p")) #'agent-chat-history-previous-block))
        (should (eq (key-binding (kbd "TAB")) #'agent-chat-history-toggle-fold))
        (should (eq (key-binding (kbd "<tab>")) #'agent-chat-history-toggle-fold)))
      (evil-normal-state)
      (deactivate-mark)
      (evil-local-mode -1)
      (should (eq (key-binding (kbd "C-n")) #'agent-chat-history-next-block))
      (should (eq (key-binding (kbd "C-p")) #'agent-chat-history-previous-block))
      (select-window prompt)
      (should (eq tab (key-binding (kbd "TAB"))))
      (should (eq next (key-binding (kbd "C-n"))))
      (should (eq previous (key-binding (kbd "C-p")))))))

(ert-deftest agent-chat-native-block-navigation-pauses-stream-follow ()
  (agent-chat-native-with-view
    (agent-chat-native-fill owner)
    (select-window history)
    (goto-char (point-max))
    (let ((this-command 'agent-chat-history-previous-block))
      (call-interactively (key-binding (kbd "C-p")))
      (agent-chat--history-post-command)
      ;; Redisplay's scroll hook must not reenable follow at this block.
      (agent-chat--history-scroll history (window-start history)))
    (should-not agent-chat--history-follow)
    (should (= 49 (get-text-property (point) 'agent-chat-block-start)))
    (let ((at (point)))
      (with-current-buffer owner
        (agent-chat--append agent-chat--state 'assistant "NEW BLOCK")
        (agent-chat--publish))
      (should (= at (point)))
      (should (eq (selected-window) history))
      (agent-chat-history-next-block)
      (should (looking-at-p "• NEW BLOCK")))
    ;; A fresh layout keeps block boundaries while native lines are rewrapped.
    (with-current-buffer owner (agent-chat-revert-buffer))
    (goto-char (point-min))
    (agent-chat-history-next-block 50)
    (should (looking-at-p "• NEW BLOCK"))))

