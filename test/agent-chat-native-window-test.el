    (should (= 3 (get-text-property (point) 'agent-chat-entry)))
    (call-interactively (key-binding (kbd "TAB")))
    (should-not (string-match-p "TOOL DETAILS" (buffer-string)))
    (goto-char (text-property-any (point-min) (point-max) 'agent-chat-group 2))
    (call-interactively (key-binding (kbd "TAB")))
    (should (looking-at-p "▸ Activity"))
    (should-not (string-match-p "TOOL SUMMARY" (buffer-string)))
    (goto-char (point-min))
    (search-forward "Example")
    (backward-char)
    (cl-letf (((symbol-function 'browse-url) (lambda (&rest _) (ert-fail "TAB must only fold"))))
      (should-error (call-interactively (key-binding (kbd "TAB"))) :type 'user-error))
    (should (equal (with-current-buffer owner (buffer-string)) "Keep draft"))))

(ert-deftest agent-chat-native-tab-collapses-innermost-detail-from-body ()
  (agent-chat-native-with-view
    (insert "Keep draft")
    (with-current-buffer owner
      (setq-local agent-chat-process-groups-expand-by-default t
                  agent-chat--expanded '(0 1))
      (setf (agent-chat--state-history agent-chat--state)
            '((:role reasoning :text "Reasoning paragraph\n\nMore reasoning")
              (:role tool :text "First tool" :detail "First output\n\nLast output")
              (:role tool :text "Second tool" :detail "Second output")
              (:role assistant :text "After the process")))
      (agent-chat--publish))
    (select-window history)
    (goto-char (point-min))
    (search-forward "Last output")
    (backward-char)
    (call-interactively (key-binding (kbd "TAB")))
    (should (= 1 (get-text-property (point) 'agent-chat-entry)))
    (should-not (string-match-p "First output" (buffer-string)))
    (should (string-match-p "More reasoning" (buffer-string)))
    (should (string-match-p "Second tool" (buffer-string)))
    (should (with-current-buffer owner (agent-chat--process-group-expanded-p 0)))
    ;; Line endings and blank lines belong to the same innermost detail.
    (dolist (location '(line-end blank-line indentation))
      (goto-char (text-property-any (point-min) (point-max) 'agent-chat-entry 1))
      (call-interactively (key-binding (kbd "TAB")))
      (search-forward "First output")
      (pcase location
        ('line-end (end-of-line))
        ('blank-line (forward-line 1))
        ('indentation (beginning-of-line)))
      (call-interactively (key-binding (kbd "TAB")))
      (should (= 1 (get-text-property (point) 'agent-chat-entry)))
      (should-not (string-match-p "First output" (buffer-string))))
    (goto-char (text-property-any (point-min) (point-max) 'agent-chat-entry 0))
    (forward-line 1)
    (search-forward "More reasoning")
    (backward-char)
    (call-interactively (key-binding (kbd "<tab>")))
    (should (= 0 (get-text-property (point) 'agent-chat-entry)))
    (should (looking-at-p "▸ Reasoning"))
    (should-not (with-current-buffer owner (memq 0 agent-chat--expanded)))
    (goto-char (point-min))
    (search-forward "After the process")
    (backward-char)
    (should-error (call-interactively (key-binding (kbd "TAB"))) :type 'user-error)
    ;; The separator after the process is outside the last tool's detail.
    (goto-char (text-property-any (point-min) (point-max) 'agent-chat-entry 2))
    (call-interactively (key-binding (kbd "TAB")))
    (search-forward "After the process")
    (beginning-of-line)
    (forward-line -1)
    (should-error (call-interactively (key-binding (kbd "TAB"))) :type 'user-error)
    (should (string-match-p "Second output" (buffer-string)))
    (should (equal (with-current-buffer owner (buffer-string)) "Keep draft"))))

(ert-deftest agent-chat-native-tab-finishes-fold-before-stream-refresh ()
  (agent-chat-native-with-view
    (agent-chat-native-blocks owner)
    (with-current-buffer owner
      (agent-chat-toggle-details 3)
      (setq-local agent-chat-stream-refresh-interval 60)
      (setf (agent-chat--state-status agent-chat--state) 'running)
      (setq agent-chat--render-finished-at (float-time))
      (agent-chat--publish)
      (should (timerp agent-chat--render-timer)))
    (select-window history)
    (goto-char (point-min))
    (search-forward "TOOL DETAILS")
    (backward-char)
    (let ((this-command 'agent-chat-history-toggle-fold))
      (call-interactively (key-binding (kbd "TAB")))
      (agent-chat--history-post-command))
    (should-not (string-match-p "TOOL DETAILS" (buffer-string)))
    (should (= 3 (get-text-property (point) 'agent-chat-entry)))
    (should-not (with-current-buffer owner agent-chat--render-timer))
    (should-not agent-chat--history-follow)
    ;; Fast repeated presses must always operate on the already updated view.
    (dotimes (i 4)
      (let ((this-command 'agent-chat-history-toggle-fold))
        (call-interactively (key-binding (kbd "TAB")))
        (agent-chat--history-post-command))
      (should (eq (and (string-match-p "TOOL DETAILS" (buffer-string)) t)
                  (= (% i 2) 0)))
      (should (= 3 (get-text-property (point) 'agent-chat-entry))))
    (let ((at (point)))
      (with-current-buffer owner
        (agent-chat--append agent-chat--state 'assistant "Next stream update")
        (agent-chat--flush-render))
      (should (= at (point)))
      (should (= 3 (get-text-property (point) 'agent-chat-entry))))))

(ert-deftest agent-chat-native-tab-finishes-fold-with-active-selection ()
  (agent-chat-native-with-view
    (agent-chat-native-blocks owner)
    (with-current-buffer owner (agent-chat-toggle-details 3))
    (select-window history)
    (evil-emacs-state)
    (goto-char (point-min))
    (search-forward "TOOL DETAILS")
    (set-mark (- (point) 5))
    (setq-local mark-active t transient-mark-mode t)
    (should (use-region-p))
    (call-interactively (key-binding (kbd "TAB")))
    (should-not (string-match-p "TOOL DETAILS" (buffer-string)))
    (should (= 3 (get-text-property (point) 'agent-chat-entry)))
    (should-not (use-region-p))))

(ert-deftest agent-chat-native-tab-keeps-repeated-heading-and-screen-row ()
  (skip-unless (display-graphic-p))
  (agent-chat-native-with-view
    (with-current-buffer owner
      (setq-local agent-chat-process-groups-expand-by-default t)
      (let ((detail (mapconcat (lambda (i) (format "Repeated body line %d" i))
                               (number-sequence 1 80) "\n")))
        (setf (agent-chat--state-history agent-chat--state)
              (cl-loop repeat 20 append
                       (list '(:role assistant :text "Same surrounding message")
                             (list :role 'tool :text "Repeated tool" :detail detail)))))
      (agent-chat--publish))
    (select-window history)
    (goto-char (text-property-any (point-min) (point-max) 'agent-chat-entry 21))
    (recenter 3)
    (redisplay t)
    (let ((start (window-start)))
      (dotimes (_ 6)
        (let ((this-command 'agent-chat-history-toggle-fold))
          (call-interactively (key-binding (kbd "TAB")))
          (agent-chat--history-post-command)
          (redisplay t))
        (should (= 21 (get-text-property (point) 'agent-chat-entry)))
        (should (= start (window-start)))
        (should (pos-visible-in-window-p (point) history))))
    ;; A title above the visible part of a long body must return to this
    ;; entry's title, even when every surrounding title has identical text.
    (call-interactively (key-binding (kbd "TAB")))
    (search-forward "Repeated body line 60")
    (recenter 3)
    (redisplay t)
    (call-interactively (key-binding (kbd "TAB")))
    (redisplay t)
    (should (= 21 (get-text-property (point) 'agent-chat-entry)))
    (should (= (window-start) (line-beginning-position)))))

