;;; agent-chat-native-window-test.el --- Native Agent Chat view contracts -*- lexical-binding: t; no-byte-compile: t; -*-

(require 'consult)
(require 'perspective)

(require 'ert)
(require 'evil)
(require 'consult-agent-chat)

(defmacro agent-chat-native-with-view (&rest body)
  "Run BODY with an isolated native window pair and OWNER draft."
  (declare (indent 0) (debug t))
  `(save-window-excursion
     (let ((owner (generate-new-buffer " *agent-chat-native-draft*"))
           (source (generate-new-buffer " *agent-chat-native-source*"))
           (evil-mode t)
           (last-command nil)
           (this-command nil)
           (agent-chat-process-groups-expand-by-default nil)
           (agent-chat-stream-refresh-interval 0)
           (agent-chat-render-math nil)
           (agent-chat-render-mermaid nil))
       (unwind-protect
           (progn
             (switch-to-buffer source)
             (delete-other-windows)
             (select-window (split-window-right))
             (switch-to-buffer owner)
             (agent-chat-mode)
             (evil-local-mode 1)
             (agent-chat--install-editing-bindings)
             (evil-normal-state)
             (agent-chat--attach (agent-chat--state-create) nil "Native test")
             (agent-chat--redraw)
             (let* ((prompt (selected-window))
                    (messages agent-chat--history-buffer)
                    (history (get-buffer-window messages)))
               ,@body))
         (when (buffer-live-p owner)
           (with-current-buffer owner
             (let ((kill-buffer-query-functions nil)) (kill-buffer owner))))
         (kill-buffer source)))))

(defun agent-chat-native-fill (owner)
  "Fill OWNER with enough messages for a scrollable history."
  (with-current-buffer owner
    (dotimes (i 50)
      (agent-chat--append agent-chat--state 'assistant
                          (format "Message %03d with stable text and a second sentence." i)))
    (agent-chat--publish)))

(ert-deftest agent-chat-native-queue-edit-click-focuses-prompt ()
  (agent-chat-native-with-view
    (let ((entry (list :draft "Queued message"))
          (other (list :draft "Next message")))
      (setq agent-chat--queue (list entry other))
      (let* ((preview (string-join (agent-chat--queue-lines 120 12) "\n"))
             (at (string-match "\\[Edit\\]" preview)))
        (should at)
        (select-window history)
        (agent-chat--queue-click
         `(mouse-1 (,prompt 1 (0 . 0) 0 (,preview . ,at))))
        (should (eq (current-buffer) owner))
        (should (eq (selected-window) prompt))
        (should (equal (buffer-string) "Queued message"))
        (should (equal agent-chat--queue (list other)))
        (should-not agent-chat--queue-paused)))))

(ert-deftest agent-chat-native-window-navigation-and-local-movement ()
  (agent-chat-native-with-view
    (should (= 3 (length (window-list))))
    (should (eq (window-atom-root prompt) (window-parent history)))
    (should (< (nth 1 (window-edges history)) (nth 1 (window-edges prompt))))
    (insert "first\nsecond\nthird")
    (goto-char 7)
    (let ((draft-point (point)))
      (evil-window-up 1)
      (should (eq (selected-window) history))
      (should buffer-read-only)
      (should (eq (key-binding (kbd "gg")) #'evil-goto-first-line))
      (should (eq (key-binding (kbd "G")) #'evil-goto-line))
      (should (eq (key-binding (kbd "C-d")) #'evil-scroll-down))
      (evil-window-down 1)
      (should (eq (selected-window) prompt))
      (should (= (point) draft-point))
      (should (eq (key-binding (kbd "G")) #'evil-goto-line))
      (should (eq (key-binding (kbd "C-u"))
                  (with-temp-buffer
                    (text-mode)
                    (evil-local-mode 1)
                    (evil-normal-state)
                    (key-binding (kbd "C-u"))))))))

