(ert-deftest agent-chat-native-queue-belongs-to-draft-without-changing-text ()
  (agent-chat-native-with-view
    (insert "Keep my draft")
    (goto-char 5)
    (set-mark 2)
    (deactivate-mark)
    (agent-chat-native-fill owner)
    (let ((undo buffer-undo-list)
          (height (window-total-height prompt))
          (tick (buffer-chars-modified-tick messages)))
      (setq agent-chat--queue (list (list :draft "TAG")))
      (agent-chat--redraw)
      (should (= 3 (length (window-list))))
      (should (> (window-total-height prompt) height))
      (should (= tick (buffer-chars-modified-tick messages)))
      (should-not (string-match-p "TAG"
                                  (with-current-buffer messages (buffer-string))))
      (select-window history)
      (goto-char (point-min))
      (set-window-start history (point-min) t)
      (agent-chat--history-post-command)
      (with-current-buffer owner
        (let* ((preview (overlay-get agent-chat--queue-preview 'before-string))
               (at (string-match "\\[Withdraw\\]" preview)))
          (should (string-match-p "TAG" preview))
          (should (eq (overlay-buffer agent-chat--queue-preview) owner))
          (should (= 1 (overlay-start agent-chat--queue-preview)))
          (agent-chat--queue-click `(mouse-1 (,prompt 1 (0 . 0) 0 (,preview . ,at))))))
      (should (eq (selected-window) history))
      (select-window prompt)
      (should-not agent-chat--queue)
      (should-not agent-chat--queue-preview)
      (should (= height (window-total-height prompt)))
      (should (equal (buffer-string) "Keep my draft"))
      (should (= 5 (point)))
      (should (= 2 (mark)))
      (should (eq undo buffer-undo-list)))))

(ert-deftest agent-chat-native-queue-display-leaves-an-editable-line ()
  (skip-unless (display-graphic-p))
  (agent-chat-native-with-view
    (setq agent-chat--queue (list (list :draft "Queued item")))
    (agent-chat--redraw)
    (redisplay t)
    (let* ((position (posn-at-point (point-min) prompt))
           (xy (posn-x-y position)))
      (should position)
      ;; Empty drafts must still put the native cursor below the preview.
      (should (>= (cdr xy) (* 2 (frame-char-height))))
      (should (< (cdr xy) (window-body-height prompt t))))
    (insert "Typing stays in the draft")
    (agent-chat--redraw)
    (should (equal (buffer-string) "Typing stays in the draft"))
    (should (= 1 (overlay-start agent-chat--queue-preview)))))

(defun agent-chat-native-blocks (owner)
  "Render a mixed conversation in OWNER with multiline and grouped content."
  (with-current-buffer owner
    (setf (agent-chat--state-history agent-chat--state)
          '((:role user :text "USER BLOCK\n\nSecond user paragraph")
            (:role assistant :text "ASSISTANT BLOCK\n\n- First list item\n- Second list item\n\n[Example](https://example.com)")
            (:role reasoning :text "THOUGHT DETAILS")
            (:role tool :text "TOOL SUMMARY" :detail "TOOL DETAILS" :tool-status "completed")
            (:role assistant :text "FINAL BLOCK\n\nLast paragraph")
            (:role notice :text "NOTICE BLOCK")))
    (agent-chat--publish)))

(ert-deftest agent-chat-native-block-navigation-skips-internal-paragraphs ()
  (agent-chat-native-with-view
    (insert "Unsent draft")
    (goto-char 4)
    (let ((undo buffer-undo-list))
      (agent-chat-native-blocks owner)
      (select-window history)
      (goto-char (point-min))
      (should (= 0 (get-text-property (point) 'agent-chat-block-start)))
      (should-error (agent-chat-history-previous-block) :type 'user-error)
      (agent-chat-history-next-block)
      (should (looking-at-p "• ASSISTANT BLOCK"))
      (let ((start (point)))
        (search-forward "Second list item")
        (agent-chat-history-previous-block)
        (should (= start (point)))
        (search-forward "Example")
        (agent-chat-history-next-block)
        (should (looking-at-p "▸ Activity"))
        (agent-chat-history-previous-block)
        (should (= start (point))))
      (agent-chat-history-next-block 2)
      (should (looking-at-p "• FINAL BLOCK"))
      (agent-chat-history-next-block)
      (should (= 5 (get-text-property (point) 'agent-chat-block-start)))
      (let ((at (point)))
        (should-error (agent-chat-history-next-block) :type 'user-error)
        (should (= at (point)))
        (agent-chat-history-next-block 0)
        (should (= at (point))))
      (goto-char (point-max))
      (agent-chat-history-previous-block)
      (should (= 5 (get-text-property (point) 'agent-chat-block-start)))
      (agent-chat-history-next-block -2)
      (should (= 2 (get-text-property (point) 'agent-chat-block-start)))
      (select-window prompt)
      (should (equal (buffer-string) "Unsent draft"))
      (should (= 4 (point)))
      (should (eq undo buffer-undo-list)))))

(ert-deftest agent-chat-native-block-navigation-retains-group-boundaries ()
  (agent-chat-native-with-view
