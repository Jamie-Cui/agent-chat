;;; agent-chat-resume-test.el --- Batched resume and preview tests -*- lexical-binding: t; no-byte-compile: t; -*-

(require 'ert)
(require 'agent-chat-native-window-test)
(require 'agent-chat-resume-probe)

(ert-deftest agent-chat-resume-formerly-rejected-math-renders-with-batched-refresh ()
  (skip-unless (and (display-graphic-p) (fboundp 'org-latex-preview-place)
                    (executable-find "xelatex") (executable-find "dvisvgm")))
  (let* ((org-latex-compiler "xelatex")
         (org-latex-preview-process-default 'dvisvgm)
         (org-latex-packages-alist '(("" "amsmath" t) ("" "amssymb" t)))
         (results (agent-chat-resume-probe-run 12 t)))
    (dolist (result results)
      (ert-info ((format "%S" result))
        (should (= (plist-get result :history-count) 12))
        (should (= (plist-get result :publications) 1))
        (should (= (plist-get result :replay-redraws) 1))
        (should (plist-get result :draft-preserved))
        (should-not (plist-get result :unfinished))
        (should (zerop (plist-get result :failed-images)))
        (unless (eq (plist-get result :case) 'disabled)
          (should (= (plist-get result :ready-images) 24))
          (should (= (plist-get result :displayed-images) 24)))))
    (let ((cold (nth 1 results)) (warm (nth 2 results)))
      (should (= (plist-get cold :preview-batches) 1))
      (should (= (plist-get cold :preview-regions) 24))
      (should (= (plist-get cold :preview-jobs) 1))
      (should (= (plist-get cold :formula-refreshes) 1))
      (should (zerop (plist-get warm :preview-batches)))
      (should (zerop (plist-get warm :formula-refreshes))))))

(ert-deftest agent-chat-resume-publishes-once-after-history-and-metadata ()
  ;; Cover both notifications queued before the ID arrives and direct replay
  ;; into a known ID, including the callback used to finish a fork.
  (dolist (known-id '(nil "saved"))
    (dolist (fork '(nil t))
      (agent-chat-native-with-view
       (insert "unsent draft")
       (let* ((session (agent-chat--session-create
                        :buffer (current-buffer) :id known-id :cwd default-directory
                        :capabilities '((loadSession . t))))
              (publications 0) success)
         (setq agent-chat--session session)
         (cl-letf (((symbol-function 'agent-chat--request)
                    (lambda (_session _request callback &rest _) (setq success callback)))
                   ((symbol-function 'agent-chat--publish)
                    (lambda ()
                      (should-not (agent-chat--session-replaying session))
                      (cl-incf publications))))
           (agent-chat--load-session
            session "saved"
            (when fork (lambda () (agent-chat--fork-settings session nil))))
           (dolist (update
                    '(((sessionUpdate . "user_message_chunk") (messageId . "u")
                       (content . ((type . "text") (text . "Hello "))))
                      ((sessionUpdate . "user_message_chunk") (messageId . "u")
                       (content . ((type . "text") (text . "again"))))
                      ((sessionUpdate . "agent_message_chunk") (messageId . "a")
                       (content . ((type . "text") (text . "Answer $x$"))))
                      ((sessionUpdate . "tool_call") (toolCallId . "t")
                       (title . "Read") (status . "in_progress"))
                      ((sessionUpdate . "tool_call_update") (toolCallId . "t")
                       (status . "completed"))
                      ((sessionUpdate . "session_info_update") (title . "Saved title"))
                      ((sessionUpdate . "config_option_update") (configOptions . [model]))))
             (agent-chat--notification
              session `((method . "session/update")
                        (params . ((sessionId . "saved") (update . ,update))))))
           (should (zerop publications))
           (funcall success '((sessionId . "saved")))
           (should (= publications 1))
           (should (eq (agent-chat--session-phase session) 'ready))
           (should-not (agent-chat--session-pending-updates session))
           (should (equal (agent-chat--session-title session) "Saved title"))
           (let ((history (agent-chat--state-history agent-chat--state)))
             (should (= (length history) 3))
             (should (equal (plist-get (car history) :text) "Hello again"))
             (should (equal (plist-get (nth 2 history) :tool-status) "completed")))
           ;; Live metadata updates must still publish after loading.
           (agent-chat--notification
            session '((method . "session/update")
                      (params . ((sessionId . "saved")
                                 (update . ((sessionUpdate . "session_info_update")
                                            (title . "New title")))))))
           (should (= publications 2))
           (should (eq (selected-window) prompt))
           (should (window-live-p history))
           (should (equal (buffer-string) "unsent draft"))))))))

(ert-deftest agent-chat-resume-failure-publishes-partial-history-and-error ()
  (agent-chat-native-with-view
   (let* ((session (agent-chat--session-create
                    :buffer (current-buffer) :id "saved" :cwd default-directory
                    :capabilities '((loadSession . t))))
          (publications 0) failure)
     (setq agent-chat--session session)
     (cl-letf (((symbol-function 'agent-chat--request)
                (lambda (_session _request _success callback &rest _) (setq failure callback)))
               ((symbol-function 'agent-chat--publish)
                (lambda () (cl-incf publications))))
       (agent-chat--load-session session "saved")
       (agent-chat--notification
        session '((method . "session/update")
                  (params . ((sessionId . "saved")
                             (update . ((sessionUpdate . "agent_message_chunk")
                                        (content . ((type . "text") (text . "Partial")))))))))
       (should (zerop publications))
       (funcall failure '((message . "Load failed")))
       (should (= publications 1))
       (should-not (agent-chat--session-replaying session))
       (should (eq (agent-chat--session-phase session) 'failed))
       (should (eq (selected-window) prompt))
       (should (window-live-p history))
       (should (equal (mapcar (lambda (entry) (plist-get entry :text))
                             (agent-chat--state-history agent-chat--state))
                      '("Partial" "Load failed")))))))

(ert-deftest agent-chat-resume-preview-batch-refreshes-each-live-subscriber-once ()
  (dolist (fatal-error '(nil "Converter failed"))
    (let* ((preview (generate-new-buffer " *Agent Chat batch fixture*"))
           (first (generate-new-buffer " *Agent Chat subscriber one*"))
           (second (generate-new-buffer " *Agent Chat subscriber two*"))
           (dead (generate-new-buffer " *Agent Chat dead subscriber*"))
           (agent-chat--math-running preview)
           entries refreshed cleared)
      (unwind-protect
          (progn
            (kill-buffer dead)
            (with-current-buffer preview
              (insert "abc")
              (dotimes (i 3)
                (let* ((begin (1+ i)) (end (+ 2 i))
                       (overlay (make-overlay begin end)))
                  (push (list :status 'running :begin begin :end end :image nil :error nil
                              :buffers (list first second dead)) entries)
                  (overlay-put overlay 'org-overlay-type 'org-latex-overlay)
                  (if (= i 2) (overlay-put overlay 'help-echo "Invalid formula")
                    (overlay-put overlay 'org-preview-image
                                 '(image :type svg :file "fixture.svg")))))
              (setq agent-chat--math-entries (nreverse entries)
                    entries agent-chat--math-entries))
            (cl-letf (((symbol-function 'run-at-time) (lambda (&rest _) nil))
                      ((symbol-function 'org-latex-preview-clear-cache)
                       (lambda (begin end) (push (list begin end) cleared)))
                      ((symbol-function 'agent-chat--math-refresh)
                       (lambda ()
                         ;; No partial cache snapshot or stale batch owner is
                         ;; visible when a subscriber starts rebuilding.
                         (should-not agent-chat--math-running)
                         (should-not (buffer-live-p preview))
                         (should (equal (mapcar (lambda (e) (plist-get e :status)) entries)
                                        (if fatal-error '(failed failed failed)
                                          '(ready ready failed))))
                         (push (current-buffer) refreshed))))
              (agent-chat--math-complete preview fatal-error)
              (should (= (length refreshed) 2))
              (should (memq first refreshed))
              (should (memq second refreshed))
              (should (equal cleared (unless fatal-error '((3 4)))))
              (should (equal (plist-get (nth 2 entries) :error)
                             (or fatal-error "Invalid formula")))
              ;; Duplicate completion callbacks are harmless.
              (agent-chat--math-complete preview fatal-error)
              (should (= (length refreshed) 2))))
        (dolist (buffer (list preview first second dead))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(provide 'agent-chat-resume-test)
;;; agent-chat-resume-test.el ends here
