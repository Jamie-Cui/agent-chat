;;; consult-agent-chat-ignore-test.el --- Ignore a perspective conversation -*- lexical-binding: t; no-byte-compile: t; -*-

(require 'consult)
(require 'perspective)

(require 'ert)
(require 'consult-agent-chat)
(require 'agent-chat-mode-line-test)

(defmacro consult-agent-chat-ignore-test--workspace (&rest body)
  "Run BODY with two conversations, one shared with another perspective."
  (declare (indent 0) (debug t))
  `(save-window-excursion
     (agent-chat-mode-line-test--with-perspectives
       (let* ((source (generate-new-buffer " *ignore-source*"))
              (first (agent-chat-mode-line-test--conversation " *ignore-first*" "/tmp/" 'running))
              (second (agent-chat-mode-line-test--conversation " *ignore-second*" "/tmp/" 'idle))
              (history (generate-new-buffer " *ignore-history*"))
              (a (agent-chat-mode-line-test--perspective "A" (list source first second history)))
              (b (agent-chat-mode-line-test--perspective "B" (list first history)))
              (session (buffer-local-value 'agent-chat--session first)))
         (unwind-protect
             (progn
               (ignore b)
               (switch-to-buffer source)
               (set-frame-parameter nil 'persp--curr a)
               (with-current-buffer history
                 (setq major-mode 'agent-chat-history-mode agent-chat--owner first))
               (with-current-buffer first (insert "Keep this running session's draft"))
               (setf (agent-chat--session-busy session) t
                     (agent-chat--session-client session) 'inert-client)
               (agent-chat-mode-line-mode 1)
               ,@body)
           (dolist (buffer (list source first second history))
             (when (buffer-live-p buffer) (kill-buffer buffer))))))))

(ert-deftest consult-agent-chat-ignore-selects-target-in-second-picker ()
  (consult-agent-chat-ignore-test--workspace
    (let ((reads 0)
          (multi (symbol-function 'consult--multi)))
      (cl-letf (((symbol-function 'consult--multi)
                 (lambda (sources &rest options)
                   (when (= reads 1)
                     (should (equal (plist-get options :prompt) "Ignore Agent Chat buffer: "))
                     (should (= 1 (length sources)))
                     (should-not (plist-get (car sources) :state)))
                   (apply multi sources options)))
                ((symbol-function 'consult--read)
                 (lambda (collection &rest options)
                   (cl-incf reads)
                   (let* ((candidates (funcall collection nil))
                          (chosen (if (= reads 1)
                                      (cl-find-if (lambda (c) (string-prefix-p "Ignore agent-chat buffer" c)) candidates)
                                    (cl-find-if (lambda (c) (eq first (cdr (get-text-property 0 'multi-category c)))) candidates))))
                     ;; The first selection only opens the second picker.
                     (should (memq first (persp-buffers a)))
                     (should (memq second (persp-buffers a)))
                     (when (= reads 2)
                       (should (= 2 (length candidates)))
                       (should (eq (plist-get options :require-match) t)))
                     (should chosen)
                     (funcall (plist-get options :lookup) chosen candidates)))))
        (consult-agent-chat-buffer))
      (should (= reads 2)))
    (should-not (memq first (persp-buffers a)))
    (should-not (memq history (persp-buffers a)))
    (should (memq second (persp-buffers a)))
    (should (equal (persp-buffers b) (list first history)))
    (should (equal (consult-agent-chat-buffer--buffers) (list second)))
    (should (equal (agent-chat-mode-line--render) " (A: A1) "))
    (should (buffer-live-p first))
    (should (buffer-live-p history))
    (should (eq session (buffer-local-value 'agent-chat--session first)))
    (should (agent-chat--session-busy session))
    (should (eq (agent-chat--session-client session) 'inert-client))
    (should-not (agent-chat--session-stopped session))
    (should (equal (with-current-buffer first (buffer-string)) "Keep this running session's draft"))))

(ert-deftest consult-agent-chat-ignore-cancel-second-picker-preserves-membership ()
  (consult-agent-chat-ignore-test--workspace
    (let ((before (copy-sequence (persp-buffers a))) (reads 0) cancelled)
      (cl-letf (((symbol-function 'consult--read)
                 (lambda (collection &rest options)
                   (cl-incf reads)
                   (when (= reads 2) (signal 'quit nil))
                   (let* ((candidates (funcall collection nil))
                          (chosen (cl-find-if (lambda (c) (string-prefix-p "Ignore agent-chat buffer" c)) candidates)))
                     (funcall (plist-get options :lookup) chosen candidates)))))
        (condition-case nil (consult-agent-chat-buffer) (quit (setq cancelled t))))
      (should cancelled)
      (should (= reads 2))
      (should (equal before (persp-buffers a)))
      (should (equal (agent-chat-mode-line--render) " (A: A2 ⠋) ")))))

(ert-deftest consult-agent-chat-ignore-last-member-can-be-disassociated ()
  (consult-agent-chat-ignore-test--workspace
    (setf (persp-buffers a) (list first))
    (let ((kill-buffer-query-functions '(persp-maybe-kill-buffer)))
      (cl-letf (((symbol-function 'consult--read)
                 (lambda (collection &rest options)
                   (funcall (plist-get options :lookup) "" (funcall collection nil)))))
        (consult-agent-chat-buffer--ignore a)))
    (should-not (persp-buffers a))
    (should (equal (agent-chat-mode-line--render) " (A: A0) "))
    (should (memq first (persp-buffers b)))
    (should (buffer-live-p first))))

(ert-deftest consult-agent-chat-ignore-rejects-changed-perspective ()
  (consult-agent-chat-ignore-test--workspace
    (cl-letf (((symbol-function 'consult--read)
               (lambda (collection &rest options)
                 (prog1 (funcall (plist-get options :lookup) "" (funcall collection nil))
                   (set-frame-parameter nil 'persp--curr b)))))
      (should-error (consult-agent-chat-buffer--ignore a) :type 'user-error))
    (should (memq first (persp-buffers a)))
    (should (memq first (persp-buffers b)))))

(provide 'consult-agent-chat-ignore-test)
;;; consult-agent-chat-ignore-test.el ends here
