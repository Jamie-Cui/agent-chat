;;; consult-agent-chat-new-test.el --- Agent Chat picker creation tests -*- lexical-binding: t; no-byte-compile: t; -*-

(require 'consult)
(require 'perspective)

(require 'ert)
(require 'consult-agent-chat)

(defun consult-agent-chat-new-test--buffer (directory &optional scope)
  "Return an inert conversation in DIRECTORY with SCOPE."
  (let ((buffer (generate-new-buffer " *agent-chat-new-test*")))
    (with-current-buffer buffer
      (setq-local major-mode 'agent-chat-mode
                  default-directory directory
                  agent-chat--scope (or scope 'directory)))
    buffer))

(defmacro consult-agent-chat-new-test--workspace (&rest body)
  "Run BODY in an isolated project, recording creation without starting agents."
  (declare (indent 0) (debug t))
  `(let ((directory (expand-file-name "agent-chat-picker/current/" temporary-file-directory))
         (buffers nil) created)
     (with-temp-buffer
       (setq default-directory directory)
       (let ((origin (current-buffer)))
         (cl-letf (((symbol-function 'project-current)
                    (lambda (&rest _) (ert-fail "The picker must not discover projects")))
                   ((symbol-function 'consult-agent-chat-buffer--buffers)
                    (lambda () buffers))
                   ((symbol-function 'agent-chat)
                    (lambda (&optional _agent _directory new)
                      (interactive)
                      (should (eq new 'select))
                      (push (list (current-buffer) default-directory) created))))
           (unwind-protect
               (progn ,@body)
             (mapc #'kill-buffer buffers)))))))

(ert-deftest consult-agent-chat-new-empty-picker-default-creates ()
  (consult-agent-chat-new-test--workspace
    (cl-letf (((symbol-function 'consult--read)
               (lambda (collection &rest options)
                 (let* ((candidates (funcall collection nil))
                        (candidate (car candidates)))
                   (should (= 1 (length candidates)))
                   (should (string-prefix-p "New agent-chat buffer" candidate))
                   (should (eq 'agent-chat-action
                               (car (get-text-property 0 'multi-category candidate))))
                   (should (equal "Actions" (funcall (plist-get options :group) candidate nil)))
                   (should (plist-get options :require-match))
                   (should-not (plist-get options :sort))
                   (should-not created)
                   (funcall (plist-get options :lookup) "" candidates)))))
      (consult-agent-chat-buffer))
    (should (equal created (list (list origin directory))))))

(ert-deftest consult-agent-chat-new-existing-session-is-default-with-action-last ()
  (consult-agent-chat-new-test--workspace
    (setq buffers (list (consult-agent-chat-new-test--buffer directory)))
    (cl-letf (((symbol-function 'consult--read)
               (lambda (collection &rest options)
                 (let* ((candidates (funcall collection nil))
                        (candidate (car candidates)))
                   (should (= 3 (length candidates)))
                   (should (eq 'buffer (car (get-text-property 0 'multi-category candidate))))
                   (should (equal "Sessions" (funcall (plist-get options :group) candidate nil)))
                   (should (equal "Actions" (funcall (plist-get options :group) (cadr candidates) nil)))
                   (should (string-prefix-p "New agent-chat buffer" (cadr candidates)))
                   (let ((selected (funcall (plist-get options :lookup) "" candidates)))
                     (should (eq (car selected) (car buffers)))
                     selected)))))
      (consult-agent-chat-buffer))
    (should-not created)))

(ert-deftest consult-agent-chat-new-projects-share-one-session-group ()
  (consult-agent-chat-new-test--workspace
    (setq buffers (list (consult-agent-chat-new-test--buffer directory)
                       (consult-agent-chat-new-test--buffer
                         (expand-file-name "other/current/" directory))))
    (cl-letf (((symbol-function 'consult--read)
               (lambda (collection &rest options)
                 (let* ((candidates (funcall collection nil))
                        (group (plist-get options :group)))
                   (should (= 4 (length candidates)))
                   (should (equal (mapcar (lambda (candidate) (funcall group candidate nil)) candidates)
                                  '("Sessions" "Sessions" "Actions" "Actions")))
                   (should (string-prefix-p "New agent-chat buffer" (cl-find-if (lambda (candidate) (string-prefix-p "New agent-chat buffer" candidate)) candidates)))
                   (funcall (plist-get options :lookup) (cadr candidates) candidates)))))
      (consult-agent-chat-buffer))
    (should-not created)))

(ert-deftest consult-agent-chat-new-cancel-does-not-create ()
  (consult-agent-chat-new-test--workspace
    (let (cancelled)
      (cl-letf (((symbol-function 'consult--read)
                 (lambda (collection &rest _)
                   (should (funcall collection nil))
                   (signal 'quit nil))))
        (condition-case nil
            (consult-agent-chat-buffer)
          (quit (setq cancelled t))))
      (should cancelled)
      (should-not created))))

(ert-deftest consult-agent-chat-new-preview-is-inert-and-creation-uses-origin ()
  (consult-agent-chat-new-test--workspace
    (setq buffers (list (consult-agent-chat-new-test--buffer
                         (expand-file-name "other/" directory))))
    (let* (events
           (consult-agent-chat-source
            (append (list :state (lambda ()
                                  (lambda (action candidate)
                                    (push (list action candidate) events))))
                    consult-agent-chat-source)))
      (cl-letf (((symbol-function 'consult--read)
                 (lambda (collection &rest options)
                   (let* ((candidates (funcall collection nil))
                          (lookup (plist-get options :lookup))
                          (state (plist-get options :state))
                          (new (funcall lookup (cl-find-if (lambda (candidate) (string-prefix-p "New agent-chat buffer" candidate)) candidates) candidates))
                          (existing (funcall lookup "" candidates)))
                     (funcall state 'setup nil)
                     (funcall state 'preview existing)
                     (should (equal (car events) (list 'preview (car existing))))
                     (funcall state 'preview new)
                     (should (equal (car events) '(preview nil)))
                     (funcall state 'exit nil)
                     (funcall state 'return new)
                     (should (equal (car events) '(return nil)))
                     (should-not created)
                     ;; Creation must use the invocation context even if preview
                     ;; leaves another conversation as the current buffer.
                     (set-buffer (car buffers))
                     new))))
        (consult-agent-chat-buffer)))
    (should (equal created (list (list origin directory))))))

(ert-deftest consult-agent-chat-new-host-session-keeps-new-action ()
  (consult-agent-chat-new-test--workspace
    (setq buffers (list (consult-agent-chat-new-test--buffer
                         (expand-file-name "elsewhere/" directory) 'host)))
    (cl-letf (((symbol-function 'consult--read)
               (lambda (collection &rest options)
                 (let ((candidates (funcall collection nil)))
                   (should (= 3 (length candidates)))
                   (should (eq 'buffer (car (get-text-property 0 'multi-category (car candidates)))))
                   (should (equal "Actions" (funcall (plist-get options :group) (cadr candidates) nil)))
                   (funcall (plist-get options :lookup) "" candidates)))))
      (consult-agent-chat-buffer))
    (should-not created)))

(ert-deftest consult-agent-chat-new-can-create-with-existing-session ()
  (consult-agent-chat-new-test--workspace
    (setq buffers (list (consult-agent-chat-new-test--buffer directory)))
    (cl-letf (((symbol-function 'consult--read)
               (lambda (collection &rest options)
                 (let* ((candidates (funcall collection nil))
                        (new (cl-find-if (lambda (candidate) (string-prefix-p "New agent-chat buffer" candidate)) candidates)))
                   (should (= 3 (length candidates)))
                   (should (equal "Actions" (funcall (plist-get options :group) new nil)))
                   (funcall (plist-get options :lookup) new candidates)))))
      (consult-agent-chat-buffer))
    (should (equal created (list (list origin directory))))))

(ert-deftest consult-agent-chat-new-killed-origin-does-not-create ()
  (consult-agent-chat-new-test--workspace
    (cl-letf (((symbol-function 'consult--read)
               (lambda (collection &rest options)
                 (let ((selected (funcall (plist-get options :lookup)
                                          "" (funcall collection nil))))
                   (kill-buffer origin)
                   selected))))
      (should-error (consult-agent-chat-buffer) :type 'user-error))
    (should-not created)))

(ert-deftest consult-agent-chat-new-offers-codex-session-choice ()
  (dolist (case '((codex (:action select)) (magent nil)))
    (with-temp-buffer
      (let ((noninteractive nil)
            (current-prefix-arg '(4))
            (default-directory temporary-file-directory)
            (origin (current-buffer))
            prompts started)
        (cl-letf (((symbol-function 'project-current)
                   (lambda (&rest _) (cons 'transient temporary-file-directory)))
                  ((symbol-function 'consult-agent-chat-buffer--buffers) #'ignore)
                  ((symbol-function 'agent-chat--workspace-buffer) #'ignore)
                  ((symbol-function 'agent-chat--source-context) #'ignore)
                  ((symbol-function 'agent-chat--redraw) #'ignore)
                  ((symbol-function 'consult--read)
                   (lambda (collection &rest options)
                     (funcall (plist-get options :lookup) "" (funcall collection nil))))
                  ((symbol-function 'read-directory-name)
                   (lambda (&rest _) (ert-fail "Picker prefix must not change the workspace")))
                  ((symbol-function 'completing-read)
                   (lambda (prompt _choices &rest _)
                     (push prompt prompts)
                     (should (equal prompt "Agent: "))
                     (symbol-name (car case))))
                  ((symbol-function 'agent-chat--start)
                   (lambda (agent directory scope &optional startup)
                     (should (eq (current-buffer) origin))
                     (should (equal directory (agent-chat--normalize-directory temporary-file-directory)))
                     (should (eq scope 'directory))
                     (setq started (list agent startup))
                     origin)))
          (consult-agent-chat-buffer)
          (should (equal prompts '("Agent: ")))
          (should (equal started case)))))))

(ert-deftest consult-agent-chat-new-never-reuses-another-perspective ()
  (dolist (scope '(directory host))
    (save-window-excursion
      (with-temp-buffer
        (let* ((noninteractive nil)
               (default-directory temporary-file-directory)
               (persp-mode t)
               (perspective (make-persp-internal :name "empty"))
               (foreign (consult-agent-chat-new-test--buffer default-directory scope))
               (foreign-session (agent-chat--session-create
                                 :buffer foreign :agent 'codex :cwd default-directory
                                 :id "foreign" :phase 'ready :busy t))
               created started)
          (unwind-protect
              (progn
                (with-current-buffer foreign
                  (setq agent-chat--session foreign-session)
                  (insert "Keep the other perspective's draft"))
                (cl-letf (((symbol-function 'persp-curr) (lambda (&optional _) perspective))
                          ((symbol-function 'project-current)
                           (lambda (&rest _)
                             (and (eq scope 'directory) (cons 'transient default-directory))))
                          ((symbol-function 'agent-chat--source-context)
                           (lambda (&rest _) "New source context"))
                          ((symbol-function 'agent-chat--redraw) #'ignore)
                          ((symbol-function 'consult--read)
                           (lambda (collection &rest options)
                             (let ((candidates (funcall collection nil)))
                               (should (= 2 (length candidates)))
                               (should (string-prefix-p "New agent-chat buffer" (car candidates)))
                               (should (string-prefix-p "Include agent-chat buffer" (cadr candidates)))
                               (funcall (plist-get options :lookup) "" candidates))))
                          ((symbol-function 'completing-read)
                           (lambda (prompt &rest _)
                             (should (equal prompt "Agent: ")) "codex"))
                          ((symbol-function 'agent-chat--begin-connection)
                           (lambda (agent &optional startup)
                             (setq created (current-buffer) started startup)
                             (should (eq agent 'codex)))))
                  ;; Prove the hidden session would otherwise be reusable.
                  (should (eq (agent-chat--workspace-buffer default-directory 'codex scope) foreign))
                  (consult-agent-chat-buffer)
                  (should (buffer-live-p created))
                  (should-not (eq created foreign))
                  (should (equal started '(:action select)))
                  (should (eq (buffer-local-value 'agent-chat--scope created) scope))
                  (should (string-match-p "New source context" (with-current-buffer created (buffer-string))))
                  (should (equal (with-current-buffer foreign (buffer-string))
                                 "Keep the other perspective's draft"))
                  (should (eq foreign-session (buffer-local-value 'agent-chat--session foreign)))
                  (should (agent-chat--session-busy foreign-session))
                  (should-not (agent-chat--session-stopped foreign-session))))
            (when (buffer-live-p created) (kill-buffer created))
            (kill-buffer foreign)))))))

(provide 'consult-agent-chat-new-test)
;;; consult-agent-chat-new-test.el ends here
