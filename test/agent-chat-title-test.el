;;; agent-chat-title-test.el --- Persistent session titles -*- lexical-binding: t; no-byte-compile: t; -*-

;; Offline protocol checks with synthetic conversations and no agent process.
(require 'ert)
(require 'codex-acp)
(require 'agent-chat-native-window-test)

(defmacro agent-chat-title-with-session (&rest body)
  "Run BODY with a synthetic SESSION in a native conversation view."
  (declare (indent 0) (debug t))
  `(agent-chat-native-with-view
     (let ((session (agent-chat--session-create
                     :buffer owner :agent 'codex :cwd default-directory
                     :id "title-test" :phase 'ready :title "Old title")))
       (setq agent-chat--session session)
       (insert "Keep this draft")
       (unwind-protect (progn ,@body)
         ;; Synthetic clients have no transport or shutdown implementation.
         (setf (agent-chat--session-client session) nil)))))

(ert-deftest agent-chat-title-bridge-saves-from-both-panes ()
  (dolist (pane '(prompt history))
    (agent-chat-title-with-session
      (let* ((active-turn (cons 'success 'failure))
             (state (codex-acp--state-create :thread "title-test" :prompt active-turn))
             (client (list (cons :codex-acp-state state)))
             request success failure)
        (setf (codex-acp--state-client state) client
              (agent-chat--session-client session) client)
        (select-window (if (eq pane 'prompt) prompt history))
        (should (eq (key-binding (kbd "C-c C-r")) #'agent-chat-rename-session))
        (let ((position (point)) (window (selected-window)))
          (cl-letf (((symbol-function 'read-string)
                     (lambda (_prompt initial &rest _)
                       (should (equal initial "Old title")) "  Manual title  "))
                    ((symbol-function 'codex-acp--rpc)
                     (lambda (_state method params ok bad &optional isolated)
                       (should isolated)
                       (setq request (cons method params) success ok failure bad))))
            (call-interactively #'agent-chat-rename-session))
          (should (equal request '("thread/name/set" (threadId . "title-test") (name . "Manual title"))))
          (should (functionp failure))
          (should (equal (agent-chat--session-title session) "Old title"))
          (should-error (agent-chat-rename-session "Another") :type 'user-error)
          (funcall success nil)
          (should (equal (agent-chat--session-title session) "Manual title"))
          (should (equal (codex-acp--title-name (codex-acp--title-state state)) "Manual title"))
          (should (eq active-turn (codex-acp--state-prompt state)))
          (should (eq window (selected-window)))
          (should (= position (point)))
          (with-current-buffer owner
            (should-not agent-chat--rename-pending)
            (should (equal (buffer-string) "Keep this draft"))
            (should (string-prefix-p "Manual title" (consult-agent-chat-buffer--annotate owner)))))))))

(ert-deftest agent-chat-title-acp-uses-stored-title-and-retains-title-on-failure ()
  (agent-chat-title-with-session
    (setf (agent-chat--session-capabilities session)
          `((sessionCapabilities . ((title . ,(make-hash-table))))))
    (let (request success failure)
      (cl-letf (((symbol-function 'acp-send-request)
                 (lambda (&rest args)
                   (setq request (plist-get args :request)
                         success (plist-get args :on-success)
                         failure (plist-get args :on-failure)))))
        (agent-chat-rename-session "Requested")
        (should (equal (map-elt request :method) "session/set_title"))
        (should (equal (map-elt request :params)
                       '((sessionId . "title-test") (title . "Requested"))))
        (funcall success '((title . "Normalized")))
        (should (equal (agent-chat--session-title session) "Normalized"))
        (agent-chat-rename-session "Will fail")
        (funcall failure '((message . "Backend rejected rename")))
        (should (equal (agent-chat--session-title session) "Normalized"))
        (should (eq (agent-chat--session-phase session) 'ready))
        (should-not agent-chat--rename-pending)
        (agent-chat-rename-session "Malformed reply")
        (funcall success nil)
        (should (equal (agent-chat--session-title session) "Normalized"))
        (should-not agent-chat--rename-pending)))))

(ert-deftest agent-chat-title-advertised-command-preserves-draft ()
  (agent-chat-title-with-session
    (setf (agent-chat--session-commands session) '[((name . "rename"))])
    (let (request success)
      (cl-letf (((symbol-function 'acp-send-request)
                 (lambda (&rest args)
                   (setq request (plist-get args :request)
                         success (plist-get args :on-success)))))
        (agent-chat-rename-session "café session")
        (should (equal (map-elt request :method) "session/prompt"))
        (should (equal (map-nested-elt request '(:params prompt))
                       '[((type . "text") (text . "/rename café session"))]))
        (should (agent-chat--session-busy session))
        (agent-chat--notification
         session '((method . "session/update")
                   (params (sessionId . "title-test")
                           (update (sessionUpdate . "session_info_update") (title . "café session")))))
        (funcall success '((stopReason . "end_turn")))
        (should-not (agent-chat--session-busy session))
        (should-not agent-chat--rename-pending)
        (should (equal (agent-chat--session-title session) "café session"))
        (should (equal (buffer-string) "Keep this draft"))
        (should-not (agent-chat--state-history agent-chat--state))))))

(ert-deftest agent-chat-title-rejects-unavailable-invalid-and-busy-command ()
  (agent-chat-title-with-session
    (should-error (agent-chat-rename-session "Title") :type 'user-error)
    (setf (agent-chat--session-commands session) '[((name . "rename"))])
    (dolist (invalid '("" " \t " "two\nlines"))
      (should-error (agent-chat-rename-session invalid) :type 'user-error))
    (setf (agent-chat--session-busy session) t)
    (should-error (agent-chat-rename-session "Title") :type 'user-error)
    (should-not agent-chat--rename-pending)
    (should (equal (agent-chat--session-title session) "Old title"))
    (setf (agent-chat--session-busy session) nil)))

(ert-deftest agent-chat-title-late-reply-does-not-change-replacement ()
  (agent-chat-title-with-session
    (let* ((state (codex-acp--state-create :thread "title-test"))
           (client (list (cons :codex-acp-state state))) success)
      (setf (codex-acp--state-client state) client
            (agent-chat--session-client session) client)
      (cl-letf (((symbol-function 'codex-acp--rpc)
                 (lambda (_state _method _params ok _bad &optional _isolated)
                   (setq success ok))))
        (agent-chat-rename-session "Late title"))
      (setq agent-chat--session (agent-chat--session-create :buffer owner :title "Replacement"))
      (funcall success nil)
      (should (equal (agent-chat--session-title agent-chat--session) "Replacement"))
      (should (equal (agent-chat--session-title session) "Old title")))))

(ert-deftest agent-chat-title-bridge-stops-late-automatic-writes ()
  (let* ((state (codex-acp--state-create :thread "title-test"))
         (client (list (cons :codex-acp-state state)))
         (requests (make-hash-table :test #'equal)) saved failed)
    (setf (codex-acp--state-client state) client)
    (let ((title (codex-acp--title-state state)))
      (setf (codex-acp--title-phase title) 'saving
            (codex-acp--title-name title) "Old title")
      (cl-letf (((symbol-function 'codex-acp--rpc)
                 (lambda (_state method _params ok bad &optional _isolated)
                   (puthash method (cons ok bad) requests))))
        (codex-acp--title-save state title "Automatic title")
        (codex-acp-rename-session client "title-test" "Manual title"
                                  (lambda (name) (setq saved name))
                                  (lambda (err) (setq failed err)))
        (let ((manual (gethash "thread/name/set" requests)))
          (funcall (car (gethash "thread/read" requests)) '((thread . ((name . nil)))))
          (should (eq manual (gethash "thread/name/set" requests)))
          (funcall (cdr manual) '((message . "Save failed")))
          (should failed)
          (should-not saved)
          (should (equal (codex-acp--title-name title) "Old title")))))))

(provide 'agent-chat-title-test)
;;; agent-chat-title-test.el ends here
